---
import type { ChipProps } from "./types";

type Props = ChipProps;

const {
  label,
  visuallyHidden,
  variant = "standard",
  disabled = false,
  size = "default",
  active = false,
} = Astro.props;

const sizeMap = {
  default: "",
  large: "chip-lg",
};

const variantMap = {
  standard: "",
  "outline-white": "chip-outline-white",
  primary: "chip-primary",
};

const hiddenLabel = visuallyHidden.trim();
---

<style>
  @import "./style.scss";
</style>

<span
  class:list={[
    "chip",
    "chip-simple",
    variantMap[variant],
    sizeMap[size],
    { "chip-disabled": disabled, active },
  ]}
>
  {hiddenLabel && <span class="visually-hidden">{hiddenLabel}</span>}
  <span class="chip-label">{label}</span>
</span>
