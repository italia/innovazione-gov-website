---
import { Breadcrumb } from "@components/molecules/Breadcrumb";
import { getI18n } from "@i18n/microcopy";
import { createBreadcrumb } from "@utils/createBreadcrumb";
import type { PositionHeroProps } from "./types";

type Props = PositionHeroProps;

const { title, paragraph, meta, topics = [] } = Astro.props;
const { recordId, lang } = Astro.locals;
const t = getI18n(lang);

const breadcrumbItems = createBreadcrumb(recordId, lang);
---

<section class="position-hero">
  <div class="container">
    <Breadcrumb items={breadcrumbItems} />
    <div class="row">
      <div class="col-12 col-lg-7">
        <h1 class="position-hero__title">{title}</h1>
        {paragraph && <p class="position-hero__paragraph">{paragraph}</p>}
        {
          meta.length > 0 && (
            <dl class="position-hero__meta">
              {meta.map((voce) => (
                <div class="position-hero__meta-item">
                  <dt>{voce.label}</dt>
                  <dd>{voce.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
      {
        topics.length > 0 && (
          <div class="col-12 col-lg-4 offset-lg-1">
            <div class="position-hero__topics">
              <p class="position-hero__topics-label">{t["article.topics"]}</p>
              <ul class="position-hero__chips">
                {topics.map((topic) => (
                  <li class="position-hero__chip">{topic}</li>
                ))}
              </ul>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .position-hero {
    padding-block: 2.5rem 3rem;
  }
  .position-hero__title {
    margin-bottom: 1rem;
  }
  .position-hero__paragraph {
    margin-bottom: 2rem;
    color: #2f475e;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  .position-hero__meta {
    display: grid;
    gap: 1.5rem 2rem;
    margin: 0;
  }
  .position-hero__meta-item dt {
    color: #17334f;
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .position-hero__meta-item dd {
    margin: 0.25rem 0 0;
    font-size: 1.125rem;
    line-height: 1.5;
  }
  .position-hero__topics {
    margin-top: 2rem;
  }
  .position-hero__topics-label {
    margin-bottom: 0.75rem;
    color: #5b6f82;
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .position-hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .position-hero__chip {
    border: 1px solid #06c;
    border-radius: 999px;
    padding: 0.375rem 1rem;
    color: #06c;
    font-weight: 600;
    font-size: 0.875rem;
  }

  @media (min-width: 768px) {
    .position-hero__meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .position-hero__topics {
      margin-top: 3.5rem;
    }
  }
</style>
