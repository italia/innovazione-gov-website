---
type Props = {
  header?: string;
  items: { id: string; label: string }[];
};

const { header, items } = Astro.props;
---

<nav class="article-toc" aria-label={header}>
  {header && <p class="article-toc__title">{header}</p>}
  <div
    class="article-toc__progress"
    role="progressbar"
    aria-valuemin="0"
    aria-valuemax="100"
  >
    <span class="article-toc__progress-fill"></span>
  </div>
  <ul class="article-toc__list">
    {
      items.map((item) => (
        <li>
          <a
            class="article-toc__link"
            href={`#${item.id}`}
            data-toc-link={item.id}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .article-toc {
    position: sticky;
    top: 7rem;
    padding-right: 3.5rem;
  }
  .article-toc__title {
    text-transform: uppercase;
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.5rem;
    letter-spacing: 0.02em;
    color: #17324d;
    margin-bottom: 1.75rem;
    padding-left: 1.5rem;
  }
  .article-toc__progress {
    height: 4px;
    background: #d4d8dc;
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 2rem;
  }
  .article-toc__progress-fill {
    display: block;
    height: 100%;
    width: 0%;
    background: #435a70;
    transition: width 0.1s linear;
  }
  .article-toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .article-toc__list li a {
    padding: 0.75rem 1.5rem;
  }
  .article-toc__link {
    display: block;
    color: #06c;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.125rem;
    padding-left: 1rem;
    border-left: 3px solid transparent;
    line-height: 1.3;
  }
  .article-toc__link:hover {
    text-decoration: underline;
  }
  .article-toc__link:global(.active) {
    color: #1a1a1a;
    border-left-color: #1a1a1a;
  }
</style>

<script>
  const toc = document.querySelector(".article-toc");
  if (toc) {
    const links = Array.from(
      toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"),
    );
    const fill = toc.querySelector<HTMLElement>(".article-toc__progress-fill");
    const progress = toc.querySelector<HTMLElement>(".article-toc__progress");
    const sections = links
      .map((link) => document.getElementById(link.dataset.tocLink ?? ""))
      .filter((el): el is HTMLElement => !!el);

    const content = document.querySelector<HTMLElement>(
      ".structured-text-container",
    );

    const offset = 120;

    const update = () => {
      if (sections.length) {
        let activeIndex = 0;
        sections.forEach((section, index) => {
          if (section.getBoundingClientRect().top <= offset)
            activeIndex = index;
        });
        links.forEach((link, index) =>
          link.classList.toggle("active", index === activeIndex),
        );
      }

      const range = content ?? sections[0];
      if (!range || !fill) return;
      const start = range.offsetTop;
      const total = (content ? content.offsetHeight : window.innerHeight) || 1;
      const done = window.scrollY + offset - start;
      const pct = Math.min(100, Math.max(0, (done / total) * 100));
      fill.style.width = `${pct}%`;
      if (progress) {
        progress.setAttribute("aria-valuenow", String(Math.round(pct)));
      }
    };

    update();
    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
  }
</script>
