---
import { SectionContainer } from "@components/organisms/SectionContainer";
import { getSectionBgClass } from "@utils/background";
import type { TextOnlyProps } from "./types";

type Props = TextOnlyProps;

const { background = "default", sectionTitleId } = Astro.props;
---

<SectionContainer
  className={getSectionBgClass(background)}
  sectionTitleId={sectionTitleId}
>
  <div class="row">
    <div class="col-12 col-lg-8">
      <slot name="text" />
    </div>
  </div>
</SectionContainer>
