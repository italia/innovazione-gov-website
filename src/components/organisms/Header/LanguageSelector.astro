---
import type { SiteLocale } from "@graphql/types";
import { getI18n } from "@i18n/microcopy";
import ItExpand from "@static/assets/ItExpand.astro";
import { linkResolver } from "@utils/linkResolver";

type Props = {
  locales: string[];
};

const { locales } = Astro.props;
const { lang: currentLocale, recordId } = Astro.locals;

const localeLinks = locales
  .map((locale) => ({
    locale: locale as SiteLocale,
    href:
      locale === currentLocale
        ? Astro.url.pathname
        : linkResolver(recordId, locale),
  }))
  .filter(({ locale, href }) => locale === currentLocale || href !== "#");

const hasTranslatedPage = localeLinks.length > 1;

const t = getI18n(currentLocale);
---

{
  hasTranslatedPage && (
    <div class="nav-item dropdown">
      <a
        class="nav-link dropdown-toggle"
        href="#"
        role="button"
        data-bs-toggle="dropdown"
        aria-expanded="false"
        id="languagesDropButton"
      >
        <span class="visually-hidden">{t["header.languageSelector"]}</span>
        <span lang={currentLocale}>{t["language.short"]}</span>
        <ItExpand class="d-none d-lg-block" />
      </a>
      <div class="dropdown-menu">
        <div class="row">
          <div class="col-12">
            <div class="link-list-wrapper">
              <ul
                id="languages"
                class="link-list"
                aria-labelledby="languagesDropButton"
              >
                {localeLinks.map(({ locale, href }) => {
                  const localeMicrocopy = getI18n(locale);
                  const isCurrent = locale === currentLocale;

                  return (
                    <li>
                      <a
                        class={`dropdown-item list-item ${isCurrent ? "active" : ""}`}
                        href={href}
                        lang={locale}
                        aria-current={isCurrent ? "true" : undefined}
                      >
                        <span>
                          <span>{localeMicrocopy["language.short"]}</span>
                          {isCurrent && (
                            <span class="visually-hidden">
                              {" "}
                              {localeMicrocopy["header.languageSelected"]}
                            </span>
                          )}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}
