---
import { Image } from "@components/atoms/Image";
import type { MenuItemProps } from "./types";

type Props = MenuItemProps;

const {
  active,
  id,
  url,
  title,
  subMenuItems = [],
  subtitle,
  image,
  caption,
  isExternal = false,
} = Astro.props;

const midIndex = Math.ceil(subMenuItems.length / 2);
const leftColumn = subMenuItems.slice(0, midIndex);
const rightColumn = subMenuItems.slice(midIndex);
const ariaCurrent = active ? "page" : undefined;
const toggleId = `megamenu-toggle-${id}`;
---

{
  subMenuItems.length > 0 ? (
    <li
      class:list={["nav-item", "dropdown", "megamenu", { active }]}
      id={id}
      aria-current={ariaCurrent}
    >
      <button
        type="button"
        class:list={[
          "nav-link",
          "dropdown-toggle",
          "px-lg-2",
          "px-xl-3",
          { active },
        ]}
        data-bs-toggle="dropdown"
        aria-expanded="false"
        id={toggleId}
        data-focus-mouse="false"
      >
        <>
          <span>{title}</span>
          <svg role="img" class="icon icon-xs ms-1">
            <use href="/bsi-svg/sprites.svg#it-expand" />
          </svg>
        </>
      </button>
      <div
        class="dropdown-menu shadow-lg"
        role="region"
        aria-labelledby={toggleId}
      >
        <div class="megamenu pb-5 pt-3 py-lg-0">
          <div class="row">
            <div class="col-xs-12 col-lg-4 px-0">
              <div class="row">
                <div class="col-12 it-vertical it-description pb-lg-3">
                  <div class="description-content ps-4 ps-sm-5 ms-3">
                    {image && (
                      <div class="ratio ratio-21x9 lightgrey-bg-a1 mb-4 rounded megamenu-image">
                        <Image {...image} />
                      </div>
                    )}
                    <Fragment set:html={caption} />
                  </div>
                </div>
              </div>
            </div>
            <div class="col-12 col-lg-8">
              <div class="it-heading-link-wrapper">
                <a class="it-heading-link" href={url}>
                  <>
                    <svg role="img" class="icon icon-sm me-2 mb-1">
                      <use href="/bsi-svg/sprites.svg#it-arrow-right-triangle" />
                    </svg>
                    <span>{subtitle}</span>
                  </>
                </a>
              </div>
              <div class="row">
                <div class="col-12 col-lg-6">
                  <div class="link-list-wrapper">
                    <ul class="link-list">
                      {leftColumn.map((item) => (
                        <li>
                          <a class="list-item dropdown-item" href={item.url}>
                            <svg role="img" class="icon icon-sm me-2">
                              <use href="/bsi-svg/sprites.svg#it-arrow-right-triangle" />
                            </svg>
                            <span>{item.title}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
                <div class="col-12 col-lg-6">
                  <div class="link-list-wrapper">
                    <ul class="link-list">
                      {rightColumn.map((item) => (
                        <li>
                          <a class="list-item dropdown-item" href={item.url}>
                            <svg role="img" class="icon icon-sm me-2">
                              <use href="/bsi-svg/sprites.svg#it-arrow-right-triangle" />
                            </svg>
                            <span>{item.title}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </li>
  ) : (
    <li class={`nav-item ${active ? "active" : ""}`} id={id}>
      <a
        class={`nav-link ${active ? "active" : ""}`}
        href={url}
        target={isExternal ? "_blank" : undefined}
        rel={isExternal ? "noopener noreferrer" : undefined}
      >
        <span>{title}</span>
        {isExternal && (
          <svg
            role="img"
            class="icon icon-white ms-2 nav-external-icon"
            aria-hidden="true"
          >
            <use href="/bsi-svg/sprites.svg#it-external-link" />
          </svg>
        )}
      </a>
    </li>
  )
}

<style>
  /* icona link esterno nella secondary nav: poco più grande di icon-xs */
  .nav-external-icon {
    width: 20px;
    height: 20px;
  }

  .megamenu-image :global(img) {
    object-fit: cover;
    object-position: center;
  }

  .nav-item.megamenu > .nav-link.show,
  .nav-item.megamenu > .nav-link.active {
    box-shadow: inset 0 -3px 0 0 currentColor;
  }

  @media (min-width: 992px) {
    .nav-item.megamenu > .dropdown-menu {
      margin-top: calc(1rem + 0.625rem) !important;
    }
    .nav-item.megamenu > .dropdown-menu.show::before {
      content: "";
      position: absolute;
      top: -9px;
      left: var(--megamenu-notch-left, 2rem);
      width: 16px;
      height: 16px;
      background: #fff;
      transform: rotate(45deg);
      border-radius: 2px;
    }
  }
</style>

<script>
  const positionNotch = (item: Element) => {
    const toggle = item.querySelector<HTMLElement>(".nav-link");
    const panel = item.querySelector<HTMLElement>(".dropdown-menu");
    if (!toggle || !panel) return;
    const label = toggle.querySelector<HTMLElement>("span") ?? toggle;
    const update = () => {
      const labelBox = label.getBoundingClientRect();
      const offset =
        labelBox.left +
        labelBox.width / 2 -
        panel.getBoundingClientRect().left -
        8;
      panel.style.setProperty(
        "--megamenu-notch-left",
        `${Math.round(offset)}px`,
      );
    };
    item.addEventListener("shown.bs.dropdown", update);
    window.addEventListener("resize", update, { passive: true });
  };

  document.querySelectorAll(".nav-item.megamenu").forEach(positionNotch);
</script>
