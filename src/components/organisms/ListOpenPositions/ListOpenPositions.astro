---
import ButtonLink from "@components/atoms/Button/ButtonLink.astro";
import { Image } from "@components/atoms/Image";
import type { ImageProps } from "@components/atoms/Image/types";
import { SectionContainer } from "@components/organisms/SectionContainer";
import { getI18n } from "@i18n/microcopy";
import { getSectionBgClass } from "@utils/background";
import type { SectionBackground } from "@utils/background";
import { slugify } from "@utils/slugify";

export type OpenPositionItemProps = {
  id: string;
  title: string;
  description?: string;
  image?: ImageProps;
  linkTo: string;
};

type Props = {
  title: string;
  paragraph?: string | null;
  items: OpenPositionItemProps[];
  background?: SectionBackground;
  labelButton?: string;
  linkTo?: string;
  openInNewTab?: boolean;
};

const {
  title,
  paragraph,
  items,
  background = "default",
  labelButton,
  linkTo,
  openInNewTab = false,
} = Astro.props;

const { lang } = Astro.locals;
const t = getI18n(lang);

const isDark = background === "primary" || background === "dark";
const textColorClass = isDark ? "text-white" : "";
---

<SectionContainer
  className={`open-positions ${getSectionBgClass(background)}`}
  sectionTitleId={title}
>
  <div class="row justify-content-between">
    <div class="col-12 col-lg-5 mb-5 mb-lg-0">
      <h2 class={textColorClass} id={slugify(title)}>{title}</h2>
      {paragraph && <p class={`mb-4 ${textColorClass}`}>{paragraph}</p>}
      {
        labelButton && linkTo && (
          <ButtonLink
            size="small"
            variant={isDark ? "dark" : "light"}
            label={labelButton}
            linkTo={linkTo}
            openInNewTab={openInNewTab}
          />
        )
      }
    </div>

    <div class="col-12 col-lg-6">
      <h3 class:list={["open-positions__label", textColorClass]}>
        {t["position.latestOpen"]}
      </h3>
      {
        items.length > 0 ? (
          <ul class="open-positions__list">
            {items.map((item) => (
              <li>
                <article class="open-positions__card">
                  {item.image && (
                    <div class="open-positions__media">
                      <Image {...item.image} alt="" />
                    </div>
                  )}
                  <div class="open-positions__body">
                    <h4 class="open-positions__title">
                      <a href={item.linkTo}>
                        {item.title}
                        <svg
                          class="open-positions__icon"
                          width="26"
                          height="26"
                          viewBox="0 0 26 26"
                          fill="none"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <path
                            d="M12 3C12.4109 3.00798 12.742 3.33914 12.75 3.75C12.75 4.16421 12.4142 4.5 12 4.5H4.5C2.84315 4.5 1.5 5.84315 1.5 7.5V21C1.5 22.6569 2.84315 24 4.5 24H18.0146C19.6715 24 21.0146 22.6569 21.0146 21V12.75C21.0146 12.3359 21.3506 12.0002 21.7646 12C22.1672 12.008 22.492 12.3328 22.5 12.7354V21C22.5 23.4853 20.4853 25.5 18 25.5H4.5C2.01472 25.5 0 23.4853 0 21V7.5C0 5.01472 2.01472 3 4.5 3H12ZM24 0C24.8284 0 25.5 0.671573 25.5 1.5V9.75C25.5 10.1642 25.1642 10.5 24.75 10.5C24.3358 10.5 24 10.1642 24 9.75V2.4209L11.3066 15.1143C11.0138 15.4069 10.5389 15.407 10.2461 15.1143C9.95326 14.8214 9.95337 14.3466 10.2461 14.0537L22.7988 1.5H15.75C15.3358 1.5 15 1.16421 15 0.75C15 0.335786 15.3358 0 15.75 0H24Z"
                            fill="currentColor"
                          />
                        </svg>
                      </a>
                    </h4>
                    {item.description && (
                      <p class="open-positions__text">{item.description}</p>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ul>
        ) : (
          <p class:list={["open-positions__empty", textColorClass]}>
            {t["position.noOpen"]}
          </p>
        )
      }
    </div>
  </div>
</SectionContainer>

<style>
  .open-positions__label {
    margin-bottom: 1.5rem;
    color: #17334f;
    font-weight: 600;
    font-size: 0.875rem;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .open-positions__list {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .open-positions__card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    box-shadow: 0 4px 4px 0 rgb(0 0 0 / 15%);
    border: 1px solid var(--color-border-subtle, #c5c7c9);
    background: #f2f7fc;
    padding: 16px;
  }

  .open-positions__media {
    flex: 0 0 auto;
    width: 11.25rem;
    max-width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .open-positions__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .open-positions__body {
    flex: 1 1 14rem;
  }

  .open-positions__title {
    margin: 0 0 0.5rem;
    font-size: 32px;
    line-height: 40px;
  }

  .open-positions__title a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-primary, #06c);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .open-positions__icon {
    flex: 0 0 auto;
    align-self: center;
  }

  .open-positions__text {
    margin: 0;
    color: #1c1c1c;
    font-size: 16px;
    line-height: 1.6;
  }

  .open-positions__empty {
    margin: 0;
    color: #5b6f82;
  }
</style>
