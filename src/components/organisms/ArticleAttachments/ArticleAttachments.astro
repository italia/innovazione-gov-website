---
import { AttachmentsBox } from "@components/organisms/AttachmentsBox";
import { getI18n } from "@i18n/microcopy";
import { createDownloadUrl } from "@utils/createDownloadUrl";

type Attachment = {
  id: string;
  fileTitle?: string | null;
  file?: {
    url: string;
    filename: string;
    format: string;
    size?: number | null;
  } | null;
};

type Props = {
  attachments?: Attachment[];
};

const { attachments = [] } = Astro.props;
const { lang } = Astro.locals;
const t = getI18n(lang);

const dettagli = (file: NonNullable<Attachment["file"]>) => {
  const estensione = (file.format ?? "").toUpperCase();
  const megabyte = file.size ? (file.size / 1024 / 1024).toFixed(1) : null;
  if (!estensione && !megabyte) return "";
  return megabyte ? `${estensione} (${megabyte}mb)` : estensione;
};

const items = attachments
  .filter((attachment) => attachment.file)
  .map((attachment) => ({
    id: attachment.id,
    label: attachment.fileTitle ?? attachment.file!.filename,
    href: createDownloadUrl(attachment.file!),
    meta: dettagli(attachment.file!),
  }));
---

<AttachmentsBox
  title={t["resources.attachments"]}
  items={items}
  background="default"
/>
