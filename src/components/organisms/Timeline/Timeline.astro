---
import { Image } from "@components/atoms/Image";
import { Link } from "@components/atoms/Link";
import { SplitContent } from "@components/layout/SplitContent";
import TextContainer from "@components/molecules/TextContainer/TextContainer.astro";
import ItIcon from "@static/assets/ItIcon.astro";
import type { TimelineProps } from "./types";

type Props = TimelineProps;

const { title, paragraph, items } = Astro.props;
---

<SplitContent
  leftColumns={5}
  rightColumns={6}
  alignItems="top"
  sectionTitleId={title}
>
  <TextContainer slot="left" title={title} paragraph={paragraph ?? ""} />

  <div slot="right" class="it-section-bg-light timeline">
    <ol class="timeline__list">
      {
        items.map((item) => (
          <li class="timeline__item">
            <p class="timeline__marker">
              <span class="timeline__icon">
                <ItIcon name="it-code-circle" />
              </span>
              <span class="timeline__period">{item.period}</span>
            </p>
            <div class="timeline__content">
              <h3 class="timeline__title">{item.title}</h3>
              {item.paragraph && (
                <div class="timeline__text" set:html={item.paragraph} />
              )}
              {item.image && (
                <div class="timeline__image">
                  <Image {...item.image} />
                </div>
              )}
              {item.linkLabel && item.linkTo && (
                <div class="timeline__link">
                  <Link
                    label={item.linkLabel}
                    linkTo={item.openInNewTab ? undefined : item.linkTo}
                    url={item.openInNewTab ? item.linkTo : undefined}
                    openInNewTab={item.openInNewTab}
                  />
                </div>
              )}
            </div>
          </li>
        ))
      }
      <li class="timeline__item timeline__item--end" aria-hidden="true">
        <p class="timeline__marker">
          <span class="timeline__icon">
            <ItIcon name="it-code-circle" />
          </span>
        </p>
      </li>
    </ol>
  </div>
</SplitContent>

<script>
  const ACTIVE_CLASS = "is-active";

  const activateOnScroll = (list: Element) => {
    const items = [
      ...list.querySelectorAll(".timeline__item:not(.timeline__item--end)"),
    ];
    if (!items.length) return;

    const markers = items.map(
      (item) => item.querySelector(".timeline__icon") ?? item,
    );

    const update = () => {
      const line = window.innerHeight / 2;
      const listBox = list.getBoundingClientRect();
      const listInView = listBox.top < window.innerHeight && listBox.bottom > 0;

      let active = -1;
      markers.forEach((marker, index) => {
        if (marker.getBoundingClientRect().top <= line) active = index;
      });
      if (active === -1 && listInView) active = 0;

      items.forEach((item, index) =>
        item.classList.toggle(ACTIVE_CLASS, index === active),
      );
    };

    let scheduled = false;
    const onScroll = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => {
        scheduled = false;
        update();
      });
    };

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
  };

  document.querySelectorAll(".timeline__list").forEach(activateOnScroll);
</script>

<style>
  .timeline {
    --timeline-off: var(--color-primary-dark, #17334f);
    --timeline-on: #06c;
    padding: 2rem 1.5rem;
  }
  .timeline__list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline__list::before {
    content: "";
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: 1.4375rem;
    width: 2px;
    background: var(--timeline-off);
  }
  .timeline__item {
    position: relative;
    padding-left: 4rem;
  }
  .timeline__item:not(:last-child) {
    padding-bottom: 2.5rem;
  }
  .timeline__item--end {
    padding-bottom: 0;
  }
  .timeline__marker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.25rem -4rem;
  }
  .timeline__item--end .timeline__marker {
    margin-bottom: 0;
  }
  .timeline__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 3rem;
    height: 3rem;
    border: 6px solid #fff;
    border-radius: 50%;
    background: var(--timeline-off);
    box-shadow: 0 2px 6px rgb(23 51 79 / 0.2);
    transition: background-color 0.3s ease;
  }
  .timeline__icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
    fill: #fff;
  }
  .timeline__period {
    position: relative;
    padding: 0.375rem 0.875rem;
    border-radius: 4px;
    background: var(--timeline-off);
    color: #fff;
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.4;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
  }
  .timeline__period::before {
    content: "";
    position: absolute;
    top: 50%;
    right: 100%;
    transform: translateY(-50%);
    border-block: 5px solid transparent;
    border-right: 6px solid var(--timeline-off);
    transition: border-right-color 0.3s ease;
  }
  .timeline__item:global(.is-active) .timeline__icon {
    background: var(--timeline-on);
  }
  .timeline__item:global(.is-active) .timeline__period {
    background: var(--timeline-on);
  }
  .timeline__item:global(.is-active) .timeline__period::before {
    border-right-color: var(--timeline-on);
  }
  .timeline__title {
    margin-bottom: 0.75rem;
    color: var(--timeline-off);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .timeline__text {
    font-family: "Lora", Georgia, serif;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-secondary, #2f475e);
  }
  .timeline__text :global(p) {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
  }
  .timeline__text :global(p:last-child) {
    margin-bottom: 0;
  }
  .timeline__image {
    margin-top: 1.25rem;
  }
  .timeline__image :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .timeline__link {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }
  .timeline__link :global(a) {
    font-size: inherit;
    line-height: inherit;
  }
  .timeline__link :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline__icon,
    .timeline__period,
    .timeline__period::before {
      transition: none;
    }
  }

  @media (min-width: 992px) {
    .timeline {
      padding: 2.5rem 3rem;
    }
  }
</style>
