---
import ButtonLink from "@components/atoms/Button/ButtonLink.astro";
import { CardEditorialNews } from "@components/molecules/CardEditorialNews";
import { CardInlineMini } from "@components/molecules/CardInlineMini";
import { Carousel, CarouselItem } from "@components/molecules/Carousel";
import { SectionContainer } from "@components/organisms/SectionContainer";
import { getI18n } from "@i18n/microcopy";
import { getSectionBgClass } from "@utils/background";
import { slugify } from "@utils/slugify";
import type { ListCollectionProps } from "./types";

type Props = ListCollectionProps;

const {
  title,
  items,
  paragraph,
  background = "lighter",
  showInline = false,
  labelButton,
  linkTo,
  openInNewTab = false,
  showCategoryFilter = false,
  visibleCount = 3,
} = Astro.props;

const categories = [
  ...new Set(items.flatMap((item) => item.filterCategories ?? [])),
].sort((a, b) => a.localeCompare(b));

const withFilter = showCategoryFilter && categories.length > 0;
const filterId = `filtro-${slugify(title)}`;
const listId = `elenco-${slugify(title)}`;
const shownItems = withFilter ? items : items.slice(0, visibleCount);

const colonnaCard = shownItems.length === 2 ? "col-lg-6" : "col-lg-4";

const { lang } = Astro.locals;
const t = getI18n(lang);

const textColorClass =
  background === "primary" || background === "dark" ? "text-white" : "";

const buttonVariant =
  background === "primary" || background === "dark" ? "dark" : "light";
---

<SectionContainer
  className={getSectionBgClass(background)}
  sectionTitleId={title}
>
  <div class="row justify-content-between align-items-top">
    <div
      class:list={[withFilter ? "col-lg-7" : "col-lg-8", "col-12", "pb-lg-5"]}
    >
      <h2 class=`${textColorClass}` id={slugify(title)}>
        {title}
      </h2>
      {paragraph && <p class={`${textColorClass}`}>{paragraph}</p>}
    </div>

    {
      withFilter && (
        <div class="col-12 col-lg-4 pb-4 pb-lg-5">
          <div class="select-wrapper">
            <label
              class:list={["form-label", "text-uppercase", textColorClass]}
              for={filterId}
            >
              {t["filter.byCategory"]}
            </label>
            <select id={filterId} data-category-filter={listId}>
              <option value="">{t["filter.all"]}</option>
              {categories.map((category) => (
                <option value={category}>{category}</option>
              ))}
            </select>
          </div>
        </div>
      )
    }

    <div class:list={[!showInline && !withFilter ? "d-none d-lg-block" : ""]}>
      <ul class="it-card-list row" id={listId}>
        {
          shownItems.map((item, index) => {
            const categoryData = (item.filterCategories ?? []).join("|");
            const hidden = withFilter && index >= visibleCount;
            return showInline ? (
              <li
                class="col-12 col-lg-6"
                data-categories={categoryData}
                hidden={hidden}
              >
                <CardInlineMini {...item} />
              </li>
            ) : (
              <li
                class:list={["col-12", colonnaCard]}
                data-categories={categoryData}
                hidden={hidden}
              >
                <CardEditorialNews {...item} />
              </li>
            );
          })
        }
      </ul>
      {
        withFilter && (
          <p
            class:list={["mt-3", textColorClass]}
            data-filter-empty={listId}
            hidden
          >
            {t["filter.noResults"]}
          </p>
        )
      }
    </div>

    {
      !showInline && !withFilter && (
        <Carousel>
          {items.map((item) => (
            <CarouselItem>
              <CardEditorialNews {...item} />
            </CarouselItem>
          ))}
        </Carousel>
      )
    }

    {
      labelButton && linkTo && (
        <div class="mt-5 d-flex justify-content-center">
          <ButtonLink
            size="small"
            variant={buttonVariant}
            label={labelButton}
            linkTo={linkTo}
            openInNewTab={openInNewTab}
          />
        </div>
      )
    }
  </div>
</SectionContainer>

<style>
  .it-card-list {
    --bs-gutter-x: 0;
    gap: 2.5rem;
  }

  .it-card-list > li {
    display: flex;
    margin-bottom: 0;
    padding: 0;
  }

  .it-card-list > li :global(.it-card) {
    width: 100%;
    height: 100%;
  }

  @media (min-width: 992px) {
    .it-card-list > li.col-lg-4 {
      flex: 0 0 calc((100% - 5rem) / 3);
      max-width: calc((100% - 5rem) / 3);
    }

    .it-card-list > li.col-lg-6 {
      flex: 0 0 calc((100% - 2.5rem) / 2);
      max-width: calc((100% - 2.5rem) / 2);
    }
  }
</style>

<script>
  const applyFilter = (select: HTMLSelectElement) => {
    const listId = select.dataset.categoryFilter;
    if (!listId) return;
    const list = document.getElementById(listId);
    if (!list) return;
    const empty = document.querySelector<HTMLElement>(
      `[data-filter-empty="${listId}"]`,
    );
    const chosen = select.value;
    const cards = [...list.querySelectorAll<HTMLElement>("li")];
    let shown = 0;
    for (const card of cards) {
      const categories = (card.dataset.categories ?? "")
        .split("|")
        .filter(Boolean);
      const matches = !chosen || categories.includes(chosen);
      const visible = matches && shown < 3;
      card.hidden = !visible;
      if (visible) shown += 1;
    }
    if (empty) empty.hidden = shown > 0;
  };

  document
    .querySelectorAll<HTMLSelectElement>("[data-category-filter]")
    .forEach((select) => {
      select.addEventListener("change", () => applyFilter(select));
    });
</script>
