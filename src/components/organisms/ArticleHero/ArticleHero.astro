---
import { DateTime } from "@components/atoms/DateTime";
import { Image } from "@components/atoms/Image";
import type { ImageProps } from "@components/atoms/Image/types";
import { Breadcrumb } from "@components/molecules/Breadcrumb";
import { getI18n } from "@i18n/microcopy";
import { createBreadcrumb } from "@utils/createBreadcrumb";

type Props = {
  title: string;
  paragraph?: string | null;
  description?: string | null;
  dateTime?: string | null;
  topics?: string[];
  image?: ImageProps | null;
  logo?: ImageProps | null;
  articleType?: string | null;
  archived?: boolean;
  duration?: string | null;
  relatedProjects?: { title: string; linkTo: string }[];
};

const {
  title,
  paragraph,
  description,
  dateTime,
  topics = [],
  image,
  logo,
  articleType,
  archived = false,
  duration,
  relatedProjects = [],
} = Astro.props;
const { recordId, lang } = Astro.locals;
const t = getI18n(lang);

const rawBreadcrumb = createBreadcrumb(recordId, lang);
const isProject = articleType === "project";
const attivitaConclusa = isProject && archived;
const isFocus = articleType === "focus";
const lastLabel = isProject ? title : t["article.detail"];
const shownTopics = isProject || isFocus ? [] : topics;
const shownDate = isProject || isFocus ? null : dateTime;
const shownParagraph = isProject
  ? paragraph?.trim()
  : isFocus
    ? description?.trim()
    : null;
const shownImage = (isProject ? (logo ?? image) : image) ?? null;
const breadcrumbItems = rawBreadcrumb.map((item, index, arr) => ({
  ...item,
  label: index === arr.length - 1 ? lastLabel : item.label,
}));
---

<section
  class:list={[
    "it-hero-wrapper",
    "it-hero-wrapper--split",
    "article-hero",
    isFocus && "article-hero--focus",
    attivitaConclusa && "article-hero--archived",
  ]}
>
  <div class="container">
    <div class="row align-items-center">
      <div class="col-12 col-lg-7">
        <div class="it-hero-text-wrapper px-0 py-0">
          <Breadcrumb items={breadcrumbItems} />
          {
            attivitaConclusa && (
              <p class="article-hero__badge-riga">
                <span class="article-hero__status-badge">
                  {t["archive.chip"]}
                </span>
              </p>
            )
          }
          <h1 class="article-hero__title">{title}</h1>
          {
            shownParagraph && !attivitaConclusa && (
              <p class="article-hero__paragraph">{shownParagraph}</p>
            )
          }
          {
            shownDate && (
              <DateTime className="article-hero__date" value={shownDate} />
            )
          }
          {
            attivitaConclusa && duration && (
              <p class="article-hero__meta">
                <span class="article-hero__meta-label">
                  {t["article.duration"]}:
                </span>{" "}
                <span class="article-hero__meta-value">{duration}</span>
              </p>
            )
          }
          {
            attivitaConclusa && relatedProjects.length > 0 && (
              <p class="article-hero__meta article-hero__meta--lista">
                <span class="article-hero__meta-label">
                  {t["article.relatedInactive"]}:
                </span>
                {relatedProjects.map((progetto) =>
                  // prettier-ignore
                  <a class="article-hero__meta-link" href={progetto.linkTo}>{progetto.title}</a>,
                )}
              </p>
            )
          }
          {
            shownTopics.length > 0 && (
              <div class="article-hero__topics">
                <p class="article-hero__topics-label">{t["article.topics"]}</p>
                <ul class="article-hero__chips">
                  {shownTopics.map((topic) => (
                    <li class="article-hero__tag">{topic}</li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </div>
      {
        shownImage && (
          <div class="col-12 col-lg-5">
            <div class="article-hero__image">
              <Image {...shownImage} loading="eager" />
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .article-hero--archived .it-hero-text-wrapper .article-hero__badge-riga {
    margin-bottom: 0.75rem;
  }
  .article-hero--archived .it-hero-text-wrapper .article-hero__title {
    margin-bottom: 1rem !important;
  }
  .article-hero .it-hero-text-wrapper .article-hero__meta-value {
    color: inherit;
    font-size: inherit;
    font-weight: 700;
    line-height: inherit;
  }
  .article-hero__status-badge {
    display: inline-block;
    border-radius: 4px;
    background: var(--color-background-secondary, #5c6f82);
    padding: 0.125rem 0.75rem;
    color: #fff;
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-weight: 600;
    font-size: 14px;
    line-height: 24px;
  }
  .article-hero .it-hero-text-wrapper .article-hero__meta {
    margin-bottom: 0.25rem;
    color: var(--color-text-secondary, #2f475e);
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-weight: 400;
    font-size: 14px;
    line-height: 16px;
  }
  .article-hero__meta--lista {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .article-hero .it-hero-text-wrapper .article-hero__meta-label {
    color: inherit;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
  }
  .article-hero .it-hero-text-wrapper .article-hero__meta-link {
    color: var(--color-text-primary, #06c);
    font-weight: 600;
    text-decoration: underline;
  }
  .article-hero__meta-link:not(:last-child)::after {
    content: ",";
  }

  .article-hero {
    padding-block: 2.5rem;
    background-color: #f2f7fc;
  }
  .article-hero--focus {
    background-color: #004d99;
  }
  .article-hero--focus .article-hero__title,
  .article-hero--focus .article-hero__paragraph {
    color: #fff !important;
  }
  .article-hero--focus
    :global(.breadcrumb-container .breadcrumb .breadcrumb-item a) {
    color: #fff;
  }
  .article-hero--focus
    :global(.breadcrumb-container .breadcrumb .breadcrumb-item),
  .article-hero--focus
    :global(.breadcrumb-container .breadcrumb .breadcrumb-item .separator) {
    color: #e8f1fb;
  }
  .article-hero :global(.breadcrumb-container) {
    margin-bottom: 32px !important;
  }
  .article-hero :global(.breadcrumb) {
    font-size: 1.125rem;
  }
  .article-hero__title {
    margin-top: 0;
    margin-bottom: 0.5rem !important;
    color: #1a1a1a !important;
  }
  .article-hero :global(.article-hero__date) {
    display: block;
    color: #5b6f82;
    font-size: 0.875rem;
  }
  .article-hero__paragraph {
    margin-top: 1.5rem;
    margin-bottom: 0;
    color: #1a1a1a !important;
    font-size: 1.125rem !important;
    line-height: 1.75rem !important;
  }
  .article-hero__topics {
    margin-top: 1.5rem;
  }
  .article-hero__topics-label {
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.03em;
    font-size: 0.875rem !important;
    margin-bottom: 0.75rem !important;
    color: #1a1a1a !important;
  }
  .article-hero__chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .article-hero__tag {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 1.25rem;
    border: 1px solid #06c;
    border-radius: 999px;
    background: transparent;
    color: #06c;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .article-hero__image :global(img) {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    max-height: 280px;
  }
</style>
