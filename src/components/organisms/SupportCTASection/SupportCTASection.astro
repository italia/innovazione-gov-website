---
import { ButtonLink } from "@components/atoms/Button";
import { Image } from "@components/atoms/Image";
import { slugify } from "@utils/slugify";
import { getSectionBgClass } from "@utils/background";
import type { SupportCTASectionProps } from "./types";

type Props = SupportCTASectionProps;

const {
  title,
  paragraph,
  labelButton,
  linkTo,
  image,
  background = "lighter",
  size = "default",
  openInNewTab = false,
} = Astro.props;

const backgroundColorClass = getSectionBgClass(background);
const isDarkBackground = background === "primary" || background === "dark";
const textColorClass = isDarkBackground ? "text-white" : "";
const buttonVariant = isDarkBackground ? "dark" : "light";
---

<section
  class={`${backgroundColorClass} ${isDarkBackground ? "cta-blue" : ""} ${size === "small" ? "rounded-2" : ""}`}
  aria-labelledby={slugify(title)}
>
  <div class={`container py-5  ${size === "small" ? "px-5" : ""}`}>
    <div class={`row align-items-center justify-content-between `}>
      <div class="col-lg-6 col-12">
        <div class={`text-container mb-4 mb-lg-0 ${textColorClass}`}>
          <h3 class={`mb-3 ${textColorClass}`} id={slugify(title)}>
            {title}
          </h3>
          <div class="mb-4" set:html={paragraph} />
          {
            labelButton && linkTo && (
              <div class="mt-5">
                <ButtonLink
                  size="small"
                  variant={buttonVariant}
                  label={labelButton}
                  linkTo={linkTo}
                  openInNewTab={openInNewTab}
                />
              </div>
            )
          }
        </div>
      </div>
      <div
        class={`${size === "small" ? "d-none d-lg-block" : ""} col-lg-5  col-12`}
      >
        <div class="img-container">
          <div class={`ratio ${size === "small" ? "ratio-1x1 " : "ratio-4x3"}`}>
            <Image {...image} />
          </div>
        </div>
        <style>
          .cta-blue {
            background-color: #003366 !important;
          }
          .img-container :global(img) {
            object-fit: cover;
          }
        </style>
      </div>
    </div>
  </div>
</section>
