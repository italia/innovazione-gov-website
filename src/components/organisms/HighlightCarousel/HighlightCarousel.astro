---
import { ButtonLink } from "@components/atoms/Button";
import { Image } from "@components/atoms/Image";
import type { ImageProps } from "@components/atoms/Image/types";
import { SectionContainer } from "@components/organisms/SectionContainer";
import { getI18n } from "@i18n/microcopy";
import { slugify } from "@utils/slugify";

type Slide = {
  id: string;
  title: string;
  paragraph?: string | null;
  image?: ImageProps | null;
  linkTo: string;
};

type Props = {
  title?: string | null;
  slides: Slide[];
};

const { title: eyebrow, slides: items } = Astro.props;

const { lang } = Astro.locals;
const t = getI18n(lang);

const etichettaSezione = eyebrow ? slugify(eyebrow) : undefined;

const etichette = {
  prev: t["carousel.previous"],
  next: t["carousel.next"],
  first: t["carousel.first"],
  last: t["carousel.last"],
  slideX: t["carousel.slideX"],
  pageX: t["carousel.pageX"],
  select: t["carousel.select"],
  carousel: t["carousel.label"],
  slide: t["carousel.slide"],
  slideLabel: t["carousel.slideLabel"],
};
---

<SectionContainer
  className="highlight-carousel"
  sectionTitleId={etichettaSezione}
>
  <div
    class="splide highlight-carousel__splide"
    data-etichette={JSON.stringify(etichette)}
    aria-label={eyebrow ?? undefined}
  >
    <div class="splide__track">
      <div class="splide__list">
        {
          items.map((slide, indice) => (
            <div class="splide__slide">
              <div class="highlight-carousel__slide row align-items-center">
                <div class="col-12 col-lg-6">
                  {eyebrow && (
                    <p
                      class="highlight-carousel__eyebrow"
                      id={indice === 0 ? etichettaSezione : undefined}
                    >
                      {eyebrow}
                    </p>
                  )}
                  <h2 class="highlight-carousel__title">{slide.title}</h2>
                  {slide.paragraph && (
                    <div
                      class="highlight-carousel__text"
                      set:html={slide.paragraph}
                    />
                  )}
                  <div class="highlight-carousel__cta">
                    <ButtonLink
                      size="small"
                      label={t["highlight.readMore"]}
                      linkTo={slide.linkTo}
                    />
                  </div>
                </div>
                {slide.image && (
                  <div class="col-12 col-lg-6">
                    <div class="highlight-carousel__media">
                      <Image {...slide.image} />
                    </div>
                  </div>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    {
      items.length > 1 && (
        <div class="highlight-carousel__comandi">
          <div class="splide__arrows highlight-carousel__frecce">
            <button
              type="button"
              class="splide__arrow splide__arrow--prev highlight-carousel__arrow"
            >
              <svg
                width="8"
                height="14"
                viewBox="0 0 8 14"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M7 1L1 7L7 13"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
            <button
              type="button"
              class="splide__arrow splide__arrow--next highlight-carousel__arrow"
            >
              <svg
                width="8"
                height="14"
                viewBox="0 0 8 14"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M1 1L7 7L1 13"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>

          <ul class="splide__pagination highlight-carousel__dots" />
        </div>
      )
    }
  </div>
</SectionContainer>

<script>
  import Splide from "@splidejs/splide";

  type EtichetteCarosello = {
    prev: string;
    next: string;
    first: string;
    last: string;
    slideX: string;
    pageX: string;
    select: string;
    carousel: string;
    slide: string;
    slideLabel: string;
  };

  const chiavi: (keyof EtichetteCarosello)[] = [
    "prev",
    "next",
    "first",
    "last",
    "slideX",
    "pageX",
    "select",
    "carousel",
    "slide",
    "slideLabel",
  ];

  const sonoEtichette = (valore: unknown): valore is EtichetteCarosello => {
    if (typeof valore !== "object" || valore === null) return false;
    const voci = new Map(Object.entries(valore));
    return chiavi.every((chiave) => typeof voci.get(chiave) === "string");
  };

  const leggiEtichette = (el: HTMLElement): EtichetteCarosello | undefined => {
    const grezze = el.dataset.etichette;
    if (!grezze) return undefined;
    const valore: unknown = JSON.parse(grezze);
    return sonoEtichette(valore) ? valore : undefined;
  };

  document
    .querySelectorAll<HTMLElement>(".highlight-carousel__splide")
    .forEach((el) => {
      if (el.querySelectorAll(".splide__slide").length < 2) return;
      new Splide(el, {
        perPage: 1,
        perMove: 1,
        keyboard: "focused",
        arrows: true,
        pagination: true,
        autoHeight: true,
        gap: 0,
        autoplay: false,
        speed: 400,
        i18n: leggiEtichette(el),
      }).mount();
    });
</script>

<style>
  .highlight-carousel__splide {
    --highlight-carousel-dot: #d9dadb;
  }

  .highlight-carousel__eyebrow {
    margin-bottom: 1.5rem;
    color: var(--color-text-base, #1a1a1a);
    text-transform: uppercase;
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
  }

  .highlight-carousel__title {
    margin-bottom: 1rem;
    color: var(--color-text-base, #1a1a1a);
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-weight: 700;
    font-size: 32px;
    line-height: 40px;
  }

  .highlight-carousel__text {
    margin-bottom: 1.5rem;
    color: var(--color-text-base, #1a1a1a);
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
  }

  .highlight-carousel__text :global(p:last-child) {
    margin-bottom: 0;
  }

  .highlight-carousel__media :global(img) {
    width: 100%;
    height: auto;
    display: block;
    -webkit-user-drag: none;
  }

  .highlight-carousel__comandi {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }

  .highlight-carousel__frecce {
    display: flex;
    gap: 0.75rem;
  }

  .highlight-carousel__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-text-secondary, #5b6f82);
    border-radius: 4px;
    background: #fff;
    color: var(--color-text-primary, #06c);
    transition: background-color 0.2s ease-in-out;
  }

  .highlight-carousel__arrow:hover:not(:disabled) {
    background: var(--color-blue-97, #f2f7fc);
  }

  .highlight-carousel__arrow:disabled {
    border-color: #c5c7c9;
    color: #a9b2bc;
    cursor: default;
  }

  .highlight-carousel__arrow:focus-visible {
    outline: 3px solid var(--color-text-primary, #06c);
    outline-offset: 2px;
  }

  .highlight-carousel__dots {
    display: flex;
    justify-content: flex-start;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
  }

  .highlight-carousel__dots :global(.splide__pagination__page) {
    width: 1.5rem;
    height: 1.5rem;
    border: 0;
    background: transparent;
    padding: 0;
    position: relative;
  }

  .highlight-carousel__dots :global(.splide__pagination__page::before) {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--highlight-carousel-dot);
  }

  .highlight-carousel__dots
    :global(.splide__pagination__page.is-active::before) {
    background: var(--color-text-primary, #06c);
  }

  .highlight-carousel__dots :global(.splide__pagination__page:focus-visible) {
    outline: 3px solid var(--color-text-primary, #06c);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .highlight-carousel__arrow {
      transition: none;
    }
  }

  @media (min-width: 992px) {
    .highlight-carousel__media {
      padding-left: 2rem;
    }
  }
</style>
