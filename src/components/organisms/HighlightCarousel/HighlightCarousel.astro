---
import { ButtonLink } from "@components/atoms/Button";
import { Image } from "@components/atoms/Image";
import type { ImageProps } from "@components/atoms/Image/types";
import { SectionContainer } from "@components/organisms/SectionContainer";
import { getI18n } from "@i18n/microcopy";
import { slugify } from "@utils/slugify";

type Slide = {
  id: string;
  title: string;
  paragraph?: string | null;
  image?: ImageProps | null;
  linkTo: string;
};

type Props = {
  id: string;
  title?: string | null;
  slides: Slide[];
};

const { id: blockId, title: eyebrow, slides: items } = Astro.props;

const { lang } = Astro.locals;
const t = getI18n(lang);

const idPannello = (indice: number) => `evidenza-${blockId}-${indice}`;
const idComando = (indice: number) => `evidenza-${blockId}-tab-${indice}`;
const etichettaSezione = eyebrow ? slugify(eyebrow) : undefined;
---

<SectionContainer
  className="highlight-carousel"
  sectionTitleId={etichettaSezione}
>
  <div class="highlight-carousel__slides">
    {
      items.map((slide, indice) => (
        <div
          class="highlight-carousel__slide row align-items-center"
          id={idPannello(indice)}
          role="tabpanel"
          aria-labelledby={idComando(indice)}
          hidden={indice > 0}
        >
          <div class="col-12 col-lg-6">
            {eyebrow && (
              <p
                class="highlight-carousel__eyebrow"
                id={indice === 0 ? etichettaSezione : undefined}
              >
                {eyebrow}
              </p>
            )}
            <h2 class="highlight-carousel__title">{slide.title}</h2>
            {slide.paragraph && (
              <div
                class="highlight-carousel__text"
                set:html={slide.paragraph}
              />
            )}
            <div class="highlight-carousel__cta">
              <ButtonLink
                size="small"
                label={t["highlight.readMore"]}
                linkTo={slide.linkTo}
              />
            </div>
          </div>
          {slide.image && (
            <div class="col-12 col-lg-6">
              <div class="highlight-carousel__media">
                <Image {...slide.image} />
              </div>
            </div>
          )}
        </div>
      ))
    }
  </div>

  {
    items.length > 1 && (
      <div class="highlight-carousel__comandi">
        <div class="highlight-carousel__frecce">
          <button
            type="button"
            class="highlight-carousel__arrow"
            data-passo="-1"
            aria-label={t["carousel.previous"]}
            disabled
          >
            <svg
              width="8"
              height="14"
              viewBox="0 0 8 14"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M7 1L1 7L7 13"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <button
            type="button"
            class="highlight-carousel__arrow"
            data-passo="1"
            aria-label={t["carousel.next"]}
          >
            <svg
              width="8"
              height="14"
              viewBox="0 0 8 14"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M1 1L7 7L1 13"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>

        <div
          class="highlight-carousel__dots"
          role="tablist"
          aria-label={eyebrow ?? t["highlight.readMore"]}
        >
          {items.map((slide, indice) => (
            <button
              type="button"
              class="highlight-carousel__dot"
              id={idComando(indice)}
              role="tab"
              aria-controls={idPannello(indice)}
              aria-selected={indice === 0 ? "true" : "false"}
              tabindex={indice === 0 ? 0 : -1}
            >
              <span class="visually-hidden">{slide.title}</span>
            </button>
          ))}
        </div>
      </div>
    )
  }
</SectionContainer>

<script>
  const aggiorna = (contenitore: Element, indice: number) => {
    const comandi = [
      ...contenitore.querySelectorAll<HTMLButtonElement>("[role=tab]"),
    ];
    comandi.forEach((comando, i) => {
      const scelto = i === indice;
      comando.setAttribute("aria-selected", scelto ? "true" : "false");
      comando.tabIndex = scelto ? 0 : -1;
      const pannello = document.getElementById(
        comando.getAttribute("aria-controls") ?? "",
      );
      if (pannello) pannello.hidden = !scelto;
    });
    contenitore
      .querySelectorAll<HTMLButtonElement>(".highlight-carousel__arrow")
      .forEach((freccia) => {
        const passo = Number(freccia.dataset.passo ?? 0);
        const prossimo = indice + passo;
        freccia.disabled = prossimo < 0 || prossimo > comandi.length - 1;
      });
    return comandi;
  };

  document.querySelectorAll(".highlight-carousel").forEach((contenitore) => {
    const comandi = [
      ...contenitore.querySelectorAll<HTMLButtonElement>("[role=tab]"),
    ];
    if (comandi.length === 0) return;
    const scelto = () =>
      comandi.findIndex(
        (comando) => comando.getAttribute("aria-selected") === "true",
      );

    comandi.forEach((comando, indice) => {
      comando.addEventListener("click", () => {
        aggiorna(contenitore, indice)[indice]?.focus();
      });
      comando.addEventListener("keydown", (evento) => {
        const passo =
          evento.key === "ArrowRight" ? 1 : evento.key === "ArrowLeft" ? -1 : 0;
        if (!passo) return;
        evento.preventDefault();
        const prossimo = (indice + passo + comandi.length) % comandi.length;
        aggiorna(contenitore, prossimo)[prossimo]?.focus();
      });
    });

    contenitore
      .querySelectorAll<HTMLButtonElement>(".highlight-carousel__arrow")
      .forEach((freccia) => {
        freccia.addEventListener("click", () => {
          const prossimo = scelto() + Number(freccia.dataset.passo ?? 0);
          if (prossimo < 0 || prossimo > comandi.length - 1) return;
          aggiorna(contenitore, prossimo);
        });
      });

    aggiorna(contenitore, Math.max(scelto(), 0));
  });
</script>

<style>
  .highlight-carousel__eyebrow {
    margin-bottom: 1.5rem;
    color: var(--color-text-base, #1a1a1a);
    text-transform: uppercase;
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 24px;
  }

  .highlight-carousel__title {
    margin-bottom: 1rem;
    color: var(--color-text-base, #1a1a1a);
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-weight: 700;
    font-size: 32px;
    line-height: 40px;
  }

  .highlight-carousel__text {
    margin-bottom: 1.5rem;
    color: var(--color-text-base, #1a1a1a);
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 28px;
  }

  .highlight-carousel__text :global(p:last-child) {
    margin-bottom: 0;
  }

  .highlight-carousel__media :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .highlight-carousel__comandi {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 2rem;
  }

  .highlight-carousel__frecce {
    display: flex;
    gap: 0.75rem;
  }

  .highlight-carousel__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-text-secondary, #5b6f82);
    border-radius: 4px;
    background: #fff;
    color: var(--color-text-primary, #06c);
    transition: background-color 0.2s ease-in-out;
  }

  .highlight-carousel__arrow:hover:not(:disabled) {
    background: var(--color-blue-97, #f2f7fc);
  }

  .highlight-carousel__arrow:disabled {
    border-color: #c5c7c9;
    color: #a9b2bc;
    cursor: default;
  }

  .highlight-carousel__arrow:focus-visible {
    outline: 3px solid var(--color-text-primary, #06c);
    outline-offset: 2px;
  }

  .highlight-carousel__dots {
    display: flex;
    gap: 0.25rem;
  }

  .highlight-carousel__dot {
    width: 1.5rem;
    height: 1.5rem;
    border: 0;
    background: transparent;
    padding: 0;
    position: relative;
  }

  .highlight-carousel__dot::before {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #d9dadb;
  }

  .highlight-carousel__dot[aria-selected="true"]::before {
    background: var(--color-text-primary, #06c);
  }

  .highlight-carousel__dot:focus-visible {
    outline: 3px solid var(--color-text-primary, #06c);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .highlight-carousel__arrow {
      transition: none;
    }
  }

  @media (min-width: 992px) {
    .highlight-carousel__media {
      padding-left: 2rem;
    }
  }
</style>
