---
import { Image } from "@components/atoms/Image";
import type { CarouselObjectivesSlideData } from "./types";

type Props = CarouselObjectivesSlideData & {
  index: number;
};

const { title, href, body, image, index } = Astro.props;
---

<div
  class="splide__slide"
  role="group"
  aria-roledescription="slide"
  aria-label={title ?? undefined}
>
  <div class="it-single-slide-wrapper h-100 p-2">
    <div class="carousel-objectives__slide-inner">
      <div class="row g-0 h-100">
        <div class="col-12 col-lg-6">
          <div class="carousel-objectives__content">
            <h3
              class={`text-primary fw-semibold ${href ? "text-decoration-underline" : ""}`}
            >
              {href ? <a href={href}>{title}</a> : title}
            </h3>
            {body && <div set:html={body} />}
          </div>
        </div>
        {
          image && (
            <div class="col-12 col-lg-6 d-flex align-items-stretch">
              <div class="carousel-objectives__image">
                <Image
                  url={image.url}
                  alt={image.alt ?? ""}
                  width={image.width ?? 480}
                  height={image.height ?? 360}
                  loading={index === 0 ? "eager" : "lazy"}
                />
              </div>
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>
