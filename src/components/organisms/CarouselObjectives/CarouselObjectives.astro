---
import CarouselObjectivesSlide from "./CarouselObjectivesSlide.astro";
import type { CarouselObjectivesProps } from "./types";

type Props = CarouselObjectivesProps;

const { slides } = Astro.props;
---

<style is:global>
  @import "./style.scss";
</style>

<section class="carousel-objectives pt-5 pb-4" aria-label="Missioni PNRR">
  <div class="container">
    <div class="splide carousel-objectives__splide">
      <div class="splide__track">
        <div class="splide__list">
          {
            slides.map((slide, index) => (
              <CarouselObjectivesSlide {...slide} index={index} />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import Splide from "@splidejs/splide";

  document
    .querySelectorAll<HTMLElement>(".carousel-objectives__splide")
    .forEach((el) => {
      new Splide(el, {
        perPage: 1,
        perMove: 1,
        keyboard: true,
        arrows: true,
        pagination: true,
        gap: 0,
        autoplay: false,
        speed: 400,
        // su mobile la track si adatta all'altezza della slide attiva
        // (niente slide tutte alte quanto la più alta → niente spazio bianco)
        mediaQuery: "max",
        breakpoints: {
          991: {
            autoHeight: true,
          },
        },
        i18n: {
          prev: "Slide precedente",
          next: "Slide successiva",
          first: "Vai alla prima slide",
          last: "Vai all'ultima slide",
          slideX: "Vai alla slide %s",
          pageX: "Vai a pagina %s",
          carousel: "Carosello",
          slide: "slide",
          slideLabel: "%s di %s",
        },
      }).mount();
    });
</script>
