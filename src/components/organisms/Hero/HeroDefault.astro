---
import { ButtonLink } from "@components/atoms/Button";
import { Image } from "@components/atoms/Image";
import { slugify } from "@utils/slugify";
import type { HeroProps } from "./types";

type Props = HeroProps;

const {
  title,
  paragraph,
  image,
  imageMobile,
  showBreadcrumb = false,
  variant = "default",
  bgClass,
  labelButton,
  linkTo,
  variantButton,
  openInNewTab = false,
} = Astro.props;
const sizeClass = variant === "small" ? "small-size" : "default-size";

const onlyBreadcrumb =
  showBreadcrumb &&
  !title &&
  !paragraph &&
  !(labelButton && linkTo) &&
  !image &&
  !imageMobile;
---

<style>
  @import "./style.scss";
</style>

<section
  class={`it-hero-wrapper it-hero-wrapper--split ${sizeClass} ${bgClass} ${onlyBreadcrumb ? "only-breadcrumb" : ""}`}
  aria-labelledby={title ? slugify(title) : undefined}
>
  <div class="container h-100">
    <div class="row align-items-center h-100">
      <div class="col-12 col-lg-7">
        <div class="it-hero-text-wrapper px-0">
          {showBreadcrumb && <slot name="breadcrumb" />}
          {title && <h1 id={slugify(title)}>{title}</h1>}
          {paragraph && <p class="font-sans-serif">{paragraph}</p>}
          {
            labelButton && linkTo && (
              <div class="it-btn-container">
                <ButtonLink
                  size="small"
                  label={labelButton}
                  variant={variantButton}
                  linkTo={linkTo}
                  openInNewTab={openInNewTab}
                />
              </div>
            )
          }
        </div>
      </div>

      {
        (image || imageMobile) && (
          <div class="col-12 col-lg-5">
            {imageMobile && (
              <div class="hero-split__image d-block d-lg-none">
                <Image {...imageMobile} loading="eager" />
              </div>
            )}
            {image && (
              <div
                class={`hero-split__image${imageMobile ? " d-none d-lg-block" : ""}`}
              >
                <Image {...image} loading="eager" />
              </div>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
