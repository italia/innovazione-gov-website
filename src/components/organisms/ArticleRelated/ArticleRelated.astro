---
import { CardEditorialNews } from "@components/molecules/CardEditorialNews";
import type { CardEditorialNewsProps } from "@components/molecules/CardEditorialNews/types";
import { CardInlineMini } from "@components/molecules/CardInlineMini";
import { getI18n } from "@i18n/microcopy";
import { isActivityType } from "@utils/storyClassification";

type Props = {
  items: CardEditorialNewsProps[];
  focusItems?: CardEditorialNewsProps[];
  articleType?: string | null;
};

const { items, focusItems = [], articleType } = Astro.props;
const { lang } = Astro.locals;
const t = getI18n(lang);
const subtitle = isActivityType(articleType)
  ? t["related.subtitleActivity"]
  : t["related.subtitle"];
const hasContent = items.length > 0 || focusItems.length > 0;
---

{
  hasContent && (
    <section class="article-related">
      <div class="container">
        <h2 class="article-related__title">{t["related.title"]}</h2>
        <p class="article-related__subtitle">{subtitle}</p>
        {focusItems.length > 0 && (
          <ul class="it-card-list row article-related__grid article-related__focus">
            {focusItems.map((item) => (
              <li class="col-12 col-lg-6 mb-4">
                <CardInlineMini
                  id={item.id}
                  title={item.title}
                  description={item.description}
                  linkTo={item.linkTo}
                  badge={item.badge}
                  isExternal={false}
                />
              </li>
            ))}
          </ul>
        )}
        {items.length > 0 && (
          <ul class="it-card-list row article-related__grid">
            {items.map((item) => (
              <li class="col-12 col-lg-4 mb-4">
                <CardEditorialNews {...item} isExternal={false} />
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

<style>
  .article-related {
    padding-block: 5rem;
    background: #f2f7fc;
  }
  .article-related__title {
    margin-bottom: 0.5rem;
    color: #1a1a1a;
    font-weight: 700;
  }
  .article-related__subtitle {
    margin-bottom: 2.5rem;
    color: #5b6f82;
  }
  .article-related__grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
