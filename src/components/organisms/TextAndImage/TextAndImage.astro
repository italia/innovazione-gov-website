---
import { SplitContent } from "@components/layout/SplitContent";
import type { TextAndImageProps } from "./types";

type Props = TextAndImageProps;

const {
  background = "default",
  variant = "variant-1",
  sectionTitleId,
} = Astro.props;
const isWideImage = variant === "variant-2";
const columnLeftSize = isWideImage ? 4 : 6;
const columnRightSize = isWideImage ? 8 : 5;

const alignItems = isWideImage ? "top" : "center";
---

<SplitContent
  leftColumns={columnLeftSize}
  rightColumns={columnRightSize}
  alignItems={alignItems}
  background={background}
  sectionTitleId={sectionTitleId}
  classSecondColumn={isWideImage ? "ps-lg-5" : ""}
>
  <slot name="text" slot="left" />
  <slot name="image" slot="right" />
  <slot name="additionalContent" />
</SplitContent>
