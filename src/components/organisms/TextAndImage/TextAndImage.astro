---
import { SplitContent } from "@components/layout/SplitContent";
import type { TextAndImageProps } from "./types";

type Props = TextAndImageProps;

const {
  background = "default",
  variant = "variant-1",
  sectionTitleId,
  contentInRightColumn = false,
} = Astro.props;
const isWideImage = variant === "variant-2";
const columnLeftSize = isWideImage ? 4 : 6;
const columnRightSize = isWideImage ? 8 : contentInRightColumn ? 6 : 5;

const alignItems = isWideImage || contentInRightColumn ? "top" : "center";
---

<SplitContent
  leftColumns={columnLeftSize}
  rightColumns={columnRightSize}
  alignItems={alignItems}
  background={background}
  sectionTitleId={sectionTitleId}
  classSecondColumn={isWideImage || contentInRightColumn ? "ps-lg-5" : ""}
>
  <slot name="text" slot="left" />
  {
    contentInRightColumn ? (
      <slot name="additionalContent" slot="right" />
    ) : (
      <Fragment>
        <slot name="image" slot="right" />
        <slot name="additionalContent" />
      </Fragment>
    )
  }
</SplitContent>
