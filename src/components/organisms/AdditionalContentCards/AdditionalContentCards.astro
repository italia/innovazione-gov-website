---
import WideLinkCardAdapter from "@components/cms-adapters/datocms/WideLinkCardAdapter.astro";
import type { WideLinkCardFragmentType } from "@graphql/fragment/commonFragments";

type Props = {
  title?: string;
  cards: WideLinkCardFragmentType[];
  variant?: "dark" | "light";
};

const { title, cards, variant = "dark" } = Astro.props;
---

<div class="additional-content-cards">
  {
    title && (
      <h3 class:list={["it-label", variant === "light" && "text-white"]}>
        {title}
      </h3>
    )
  }
  {
    cards.map((card) => (
      <WideLinkCardAdapter block={card} variant="compact" heading="h4" />
    ))
  }
</div>

<style>
  .additional-content-cards :global(.it-label) {
    margin-bottom: 1rem;
    font-size: 1.75rem !important;
    line-height: 2rem;
  }
</style>
