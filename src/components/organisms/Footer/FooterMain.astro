---
import { SubscribeMailingList } from "@components/react/SubscribeMailingList";
import FooterBrand from "./FooterBrand.astro";
import FooterLink from "./FooterLink.astro";
import FooterLinkSupportingBrand from "./FooterLinkSupportingBrand.astro";
import { getI18n } from "@i18n/microcopy";
import type { FooterProps } from "./types";

type Props = Omit<FooterProps, "smallPrints">;
const {
  brand,
  contacts,
  social,
  columns = [],
  mailingListForm,
  topics = [],
} = Astro.props;
const lang = Astro.locals.lang || "it";
const t = getI18n(lang);
---

<div class="it-footer-main" id="footer">
  <div class="footer-banda-marchio">
    <div class="container">
      <FooterBrand {...brand} />
    </div>
  </div>

  <div class="container">
    {
      topics.length > 0 && (
        <section class="footer-argomenti px-0">
          <h4 class="footer-heading-title">{t["footer.topics"]}</h4>
          <ul class="footer-chip-list">
            {topics.map((argomento) => (
              <li>
                <a class="footer-chip" href={argomento.path}>
                  {argomento.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <section class="footer-colonne px-0">
      <div class="row">
        {
          social && social.items.length > 0 && (
            <div class="col-12 col-lg-6 pb-4">
              <h4 class="footer-heading-title">{social.title}</h4>
              <ul class="footer-social">
                {social.items.map((item) => (
                  <li>
                    <FooterLinkSupportingBrand {...item} />
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          columns.map((column) => (
            <div class="col-12 col-lg-6 pb-4">
              {column.title && (
                <h4 class="footer-heading-title">{column.title}</h4>
              )}
              <div class="link-list-wrapper">
                <ul class="footer-list">
                  {column.links.map((link) => (
                    <li>
                      <FooterLink
                        variant="dark"
                        {...link}
                        openInNewTab={!!link.url}
                        isIcon={true}
                      />
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>
    <section class="footer-fondo px-0">
      <div class="row">
        {
          contacts && (
            <div class="col-12 col-lg-6 pb-4">
              <h4 class="footer-heading-title">{contacts.title}</h4>
              <p
                class="fw-semibold mb-0 footer-address"
                set:html={contacts.address}
              />
            </div>
          )
        }
        {
          mailingListForm && (
            <div class="col-12 col-lg-6 footer-newsletter">
              <div class="footer-newsletter__intro">
                <h4 class="footer-heading-title footer-heading-title--newsletter mb-0">
                  {mailingListForm.title}
                </h4>
                <a
                  class="footer-newsletter__privacy"
                  href={mailingListForm.privacyPolicy.linkTo}
                >
                  {mailingListForm.privacyPolicy.label}
                </a>
              </div>
              <SubscribeMailingList
                client:visible
                lang={lang}
                idForm="idNewsletterForm"
              />
            </div>
          )
        }
      </div>
    </section>
  </div>
</div>

<style>
  .footer-heading-title {
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 1.75rem;
  }

  .footer-heading-title--newsletter {
    line-height: 28px;
  }

  .footer-address {
    white-space: nowrap;
  }

  .footer-banda-marchio {
    background: #003366;
    padding-block: 3rem;
  }

  .it-footer-main .footer-banda-marchio :global(.it-brand-wrapper) {
    padding: 0;
  }

  .footer-argomenti {
    padding-block: 2.5rem 2rem;
  }

  .footer-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-chip {
    display: inline-block;
    border: 1px solid #fff;
    border-radius: 999px;
    padding: 0.25rem 1rem;
    color: #fff;
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-weight: 600;
    font-size: 14px;
    line-height: 24px;
    text-decoration: none;
  }

  .footer-chip:hover,
  .footer-chip:focus-visible {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }

  .footer-colonne {
    border-top: 1px solid rgb(255 255 255 / 0.6);
    padding-block: 2.5rem 1rem;
  }

  .footer-fondo {
    border-top: 1px solid rgb(255 255 255 / 0.6);
    padding-block: 2.5rem 3.5rem;
  }

  .footer-fondo .footer-heading-title {
    margin-bottom: 1rem;
  }

  .footer-fondo .footer-heading-title--newsletter {
    margin-bottom: 0;
  }

  .footer-social,
  .footer-list {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-social {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 0.75rem 2.25rem;
  }

  @media (min-width: 768px) {
    .footer-social {
      grid-template-columns: repeat(3, max-content);
    }
  }

  .footer-list {
    gap: 0.5rem 1rem;
  }

  @media (min-width: 768px) {
    .footer-list {
      display: grid;
      grid-template-columns: repeat(2, max-content);
    }
  }

  .it-footer-main .footer-list :global(a) {
    gap: 0.75rem !important;
  }

  .it-footer-main .footer-list :global(a .icon) {
    width: 16px;
    height: 16px;
  }

  .it-footer-main .link-list-wrapper .footer-list :global(a),
  .it-footer-main .link-list-wrapper .footer-list :global(a span) {
    color: #fff;
    font-size: 14px;
    line-height: 24px;
    font-weight: 400;
    text-decoration: none;
    margin-right: 0;
  }

  .it-footer-main .link-list-wrapper .footer-list :global(a:hover),
  .it-footer-main .link-list-wrapper .footer-list :global(a:hover span) {
    text-decoration: underline;
  }

  .footer-newsletter__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 992px) {
    .footer-newsletter__intro {
      flex-direction: row;
      justify-content: space-between;
      gap: 1.5rem;
    }
  }

  .footer-newsletter__privacy {
    flex: none;
    color: #fff;
    font-size: 14px;
    line-height: 24px;
    text-decoration: none;
  }

  .footer-newsletter__privacy:hover {
    text-decoration: underline;
  }

  .footer-newsletter :global(.footer-newsletter__form) {
    display: flex;
    gap: 1rem;
  }

  .footer-newsletter :global(.footer-newsletter__input) {
    flex: 1 1 auto;
    min-width: 0;
    height: 42px;
    border: 1px solid #fff;
    border-radius: 4px;
    background: #fff;
    padding: 0 1rem;
    color: #1a1a1a;
    font-size: 14px;
  }

  .footer-newsletter :global(.footer-newsletter__input::placeholder) {
    color: #5c6f82;
    opacity: 1;
  }

  .footer-newsletter :global(.footer-newsletter__button) {
    flex: none;
    height: 42px;
    padding: 0 1rem;
    border: 1px solid #fff;
    border-radius: 4px;
    background: transparent;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
  }

  .footer-newsletter :global(.footer-newsletter__input:focus-visible),
  .footer-newsletter :global(.footer-newsletter__button:focus-visible) {
    outline: 3px solid #a2f0ef;
    outline-offset: 2px;
  }

  .footer-newsletter :global(.footer-newsletter__button:hover) {
    background: #fff;
    color: #003366;
  }

  .footer-newsletter :global(.footer-newsletter__feedback) {
    margin-top: 0.75rem;
    color: #fff;
    font-size: 14px;
    line-height: 24px;
  }
</style>
