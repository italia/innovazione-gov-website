---
import { SubscribeMailingList } from "@components/react/SubscribeMailingList";
import FooterBrand from "./FooterBrand.astro";
import FooterLink from "./FooterLink.astro";
import FooterLinkSupportingBrand from "./FooterLinkSupportingBrand.astro";
import type { FooterProps } from "./types";

type Props = Omit<FooterProps, "smallPrints">;
const { brand, contacts, social, columns = [], mailingListForm } = Astro.props;
const lang = Astro.locals.lang || "it";
---

<div class="it-footer-main" id="footer">
  <div class="container">
    <FooterBrand {...brand} />
    <section class="py-4 px-0">
      <div class="row">
        {
          contacts && (
            <div class="col-12 col-md-6 col-lg-3 pb-4">
              <h4 class="footer-heading-title">{contacts.title}</h4>
              {contacts.icon && (
                <svg class="icon icon-sm icon-white mb-3" aria-hidden="true">
                  <use href={`/bsi-svg/sprites.svg#${contacts.icon}`} />
                </svg>
              )}
              <p class="fw-semibold mb-0" set:html={contacts.address} />
            </div>
          )
        }
        {
          social && social.items.length > 0 && (
            <div class="col-12 col-md-6 col-lg-3 pb-4">
              <h4 class="footer-heading-title">{social.title}</h4>
              <ul class="list-inline mb-0 d-flex flex-wrap footer-social">
                {social.items.map((item) => (
                  <li class="list-inline-item">
                    <FooterLinkSupportingBrand {...item} />
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        {
          columns.map((column) => (
            <div class="col-12 col-md-6 col-lg-3 pb-4">
              {column.title && (
                <h4 class="footer-heading-title">{column.title}</h4>
              )}
              <div class="link-list-wrapper">
                <ul class="footer-list link-list clearfix">
                  {column.links.map((link) => (
                    <li>
                      <FooterLink
                        variant="dark"
                        {...link}
                        openInNewTab={!!link.url}
                        isIcon={true}
                      />
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </div>
    </section>
    {
      mailingListForm && (
        <section class="py-4 border-white border-top px-0">
          <div class="row">
            <div class="col-12 col-lg-6">
              <div class="pb-4 d-flex align-items-center justify-content-between">
                <p class="h4">{mailingListForm.title}</p>
                <a
                  class="text-white mb-2"
                  target="_blank"
                  rel="noreferrer"
                  href={mailingListForm.privacyPolicy.linkTo}
                >
                  {mailingListForm.privacyPolicy.label}
                </a>
              </div>
              <span class="bg-dark">
                <SubscribeMailingList
                  client:visible
                  lang={lang}
                  idForm="idNewsletterForm"
                />
              </span>
            </div>
          </div>
        </section>
      )
    }
  </div>
</div>

<style>
  /* Il design usa lo stile dei titoli BI per le colonne del footer, in
     maiuscolo per i primi tre e in tondo per "Trasparenza": la differenza è
     editoriale, quindi qui restano tutti uguali. */
  .footer-heading-title {
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  .footer-social {
    gap: 1.5rem 2rem;
    max-width: 12rem;
  }
  .footer-list li {
    padding: 0 0 0.75rem;
  }
</style>
