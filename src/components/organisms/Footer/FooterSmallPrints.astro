---
import { getI18n } from "@i18n/microcopy";

import FooterLink from "./FooterLink.astro";
import type { FooterSmallPrintsProps } from "./types";

type Props = FooterSmallPrintsProps;

const { links, showSitemap = false } = Astro.props;
const lang = Astro.locals.lang || "it";
const t = getI18n(lang);
---

<div class="it-footer-small-prints clearfix">
  <div class="container">
    <p class="visually-hidden">{t["footer.sectionLink"]}</p>
    <ul
      class="it-footer-small-prints-list list-unstyled mb-0 d-flex flex-column flex-md-row px-0"
    >
      {
        showSitemap && (
          <li class="d-flex align-items-center gap-2">
            <FooterLink
              label={t["footer.sitemap"]}
              linkTo={"/sitemap-index.xml"}
              openInNewTab={false}
              isIcon={true}
              variant="dark"
            />
          </li>
        )
      }
      {
        links.map((link) => (
          <li class="d-flex align-items-center gap-2">
            <FooterLink
              {...link}
              openInNewTab={!!link.url}
              isIcon={true}
              variant="dark"
            />
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .it-footer-small-prints-list {
    gap: 0.75rem 1.625rem;
  }

  .it-footer-small-prints-list li {
    padding: 0;
  }
  .it-footer-small-prints-list :global(a),
  .it-footer-small-prints-list :global(a span) {
    color: #fff;
    font-size: 14px;
    line-height: 24px;
    text-decoration: underline;
  }
  .it-footer-small-prints-list :global(a .icon) {
    fill: #fff;
    width: 16px;
    height: 16px;
  }
  .it-footer-small-prints-list :global(a:hover),
  .it-footer-small-prints-list :global(a:hover span) {
    text-decoration: none;
  }
</style>
