---
import { Icon } from "@components/atoms/Icon";
import { getI18n } from "@i18n/microcopy";
import type { FooterLinkSupportingBrandProps } from "./types";

type Props = FooterLinkSupportingBrandProps;

const { icon, label, url } = Astro.props;
const { lang } = Astro.locals;
const t = getI18n(lang);

const isSprite = !!icon && icon.startsWith("it-");
---

<a
  href={url}
  class="d-inline-flex align-items-center text-white"
  target="_blank"
  rel="noreferrer"
>
  {
    isSprite ? (
      <svg class="icon icon-sm icon-white" aria-hidden="true">
        <use href={`/bsi-svg/sprites.svg#${icon}`} />
      </svg>
    ) : (
      icon && <Icon icon={icon} className="icon-sm text-white" />
    )
  }
  <span class="footer-social__label">{label}</span>
  <span class="visually-hidden">{t["link.external"]}</span>
</a>

<style>
  a {
    text-decoration: none;
  }

  a:hover .footer-social__label {
    text-decoration: underline;
  }

  .footer-social__label {
    margin-left: 0.75rem;
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-size: 16px;
    line-height: 24px;
  }
</style>
