---
import { getI18n } from "@i18n/microcopy";
import type { FooterBrandProps } from "./types";

type Props = FooterBrandProps;

const { logo, name, linkTo } = Astro.props;
const { lang } = Astro.locals;
const t = getI18n(lang);
---

<section class="py-4 px-0">
  <div class="it-brand-wrapper">
    <a href={linkTo} aria-label={t["header.logo"]} class="text-white">
      {
        logo?.url && (
          <img
            src={logo.url}
            alt={logo.alt ?? ""}
            width={logo.width ?? undefined}
            height={logo.height ?? undefined}
            class="it-brand-logo"
          />
        )
      }
      <div class="it-brand-text">
        <div class="it-brand-title text-white">{name}</div>
      </div>
    </a>
  </div>
</section>
