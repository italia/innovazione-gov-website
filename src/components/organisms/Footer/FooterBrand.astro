---
import { getI18n } from "@i18n/microcopy";
import type { FooterBrandProps } from "./types";

type Props = FooterBrandProps;

const { logo, name, linkTo, nameInLogo = false } = Astro.props;
const { lang } = Astro.locals;
const t = getI18n(lang);
---

<section class="px-0">
  <div class="it-brand-wrapper">
    <a href={linkTo} aria-label={t["header.logo"]} class="text-white">
      {
        logo?.url && (
          <img
            src={logo.url}
            alt={nameInLogo ? name : (logo.alt ?? "")}
            width={logo.width ?? undefined}
            height={logo.height ?? undefined}
            class:list={["it-brand-logo", nameInLogo && "footer-brand-lockup"]}
          />
        )
      }
      {
        !nameInLogo && (
          <div class="it-brand-text">
            <div class="it-brand-title text-white">{name}</div>
          </div>
        )
      }
    </a>
  </div>
</section>

<style>
  /* Il lockup (emblema + D + nome su tre righe) è largo: sugli schermi
     stretti si riduce senza deformarsi. */
  .footer-brand-lockup {
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }

  @media (min-width: 992px) {
    .footer-brand-lockup {
      width: 275px;
      height: auto;
    }
  }
</style>
