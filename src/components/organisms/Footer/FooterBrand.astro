---
import type { FooterBrandProps } from "./types";

type Props = FooterBrandProps;

const { logo, name, linkTo, wordmark } = Astro.props;
---

<section class="px-0">
  <div class="it-brand-wrapper">
    <a href={linkTo} class="footer-brand">
      {
        wordmark?.url ? (
          <img
            src={wordmark.url}
            alt={wordmark.alt ?? name}
            width={wordmark.width ?? undefined}
            height={wordmark.height ?? undefined}
            class="footer-brand__wordmark"
          />
        ) : (
          <>
            {logo?.url && (
              <img src={logo.url} alt="" class="footer-brand__logo" />
            )}
            <span class="footer-brand__name">{name}</span>
          </>
        )
      }
    </a>
  </div>
</section>

<style>
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    color: #fff;
    text-decoration: none;
  }

  .footer-brand__logo {
    width: auto;
    height: 44px;
  }

  .footer-brand__wordmark {
    width: auto;
    max-width: 100%;
    height: 56px;
  }

  .footer-brand__name {
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 28px;
  }
</style>
