---
import { getI18n } from "@i18n/microcopy";
import type { FooterBrandProps } from "./types";

type Props = FooterBrandProps;

const { logo, name, linkTo, nameInLogo = false } = Astro.props;
const { lang } = Astro.locals;
const t = getI18n(lang);
---

<section class="px-0">
  <div class="it-brand-wrapper">
    <a href={linkTo} aria-label={t["header.logo"]} class="footer-brand">
      {
        logo?.url && (
          <img
            src={logo.url}
            alt={nameInLogo ? name : (logo.alt ?? "")}
            class="footer-brand__logo"
          />
        )
      }
      {!nameInLogo && <span class="footer-brand__name">{name}</span>}
    </a>
  </div>
</section>

<style>
  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    color: #fff;
    text-decoration: none;
  }

  .footer-brand__logo {
    height: 44px;
    width: auto;
  }

  .footer-brand__name {
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-size: 18px;
    line-height: 28px;
    font-weight: 400;
  }
</style>
