---
import { getI18n } from "@i18n/microcopy";
import ItExternalLink from "@static/assets/ItExternalLink.astro";
import { slugify } from "@utils/slugify";

type ExternalLink = {
  id: string;
  title?: string | null;
  link?: string | null;
  description?: string | null;
};

type Props = {
  links?: ExternalLink[];
};

const { links = [] } = Astro.props;
const { lang } = Astro.locals;
const t = getI18n(lang);

const items = links.filter((link) => link.link);
---

{
  items.length > 0 && (
    <section class="article-links">
      <h3 class="article-links__title" id={slugify(t["links.title"])}>
        {t["links.title"]}
      </h3>
      <ul class="article-links__list">
        {items.map((item) => (
          <li class="article-links__item">
            <a
              class="article-links__link"
              href={item.link!}
              target="_blank"
              rel="noopener noreferrer"
            >
              {item.title ?? item.link}
            </a>
            <span class="article-links__icon" aria-hidden="true">
              <ItExternalLink color="primary" />
            </span>
            {item.description && (
              <p class="article-links__description">{item.description}</p>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .article-links {
    margin-block: 2rem;
    border-radius: 8px;
    padding: 2rem;
    background: var(--color-blue-97, #f2f7fc);
  }

  .article-links__title {
    margin-bottom: 1.5rem;
    color: var(--color-text-base, #1a1a1a);
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-size: 40px;
    font-weight: 700;
    line-height: 48px;
  }

  .article-links__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .article-links__item {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0 1rem;
    padding: 1rem 0;
  }

  .article-links__item + .article-links__item {
    border-top: 1px solid var(--color-border-subtle, #c5c7c9);
  }

  .article-links__link {
    color: var(--color-text-primary, #06c);
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-size: 18px;
    font-weight: 600;
    line-height: 28px;
    text-decoration: underline;
  }

  .article-links__icon :global(svg) {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
  }

  .article-links__description {
    grid-column: 1 / -1;
    margin: 0.25rem 0 0;
    color: var(--color-text-secondary, #5b6f82);
    font-size: 0.9375rem;
  }
</style>
