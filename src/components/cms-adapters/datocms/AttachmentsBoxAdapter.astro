---
import type { AttachmentsBoxFragmentType } from "@graphql/fragment/commonFragments";
import ItIcon from "@static/assets/ItIcon.astro";
import { createDownloadUrl } from "@utils/createDownloadUrl";
import { slugify } from "@utils/slugify";

type Props = {
  block: AttachmentsBoxFragmentType;
};

const { block } = Astro.props;

const files = (block.downloads ?? []).filter((download) => download.doc);

const sfondo = block.backgroundColor ?? "primary";
const senzaRiquadro = sfondo === "default";

const dettagli = (doc: { format?: string | null; size?: number | null }) => {
  const estensione = (doc.format ?? "").toUpperCase();
  const megabyte = doc.size ? (doc.size / 1024 / 1024).toFixed(1) : null;
  if (!estensione && !megabyte) return "";
  return megabyte ? `${estensione} (${megabyte}mb)` : estensione;
};
---

{
  files.length > 0 && (
    <section class:list={["attachments-box", `attachments-box--${sfondo}`]}>
      <h3 class="attachments-box__title" id={slugify(block.title)}>
        {block.title}
      </h3>
      <ul class="attachments-box__list">
        {files.map((download) => (
          <li class="attachments-box__item">
            <span class="attachments-box__icon" aria-hidden="true">
              <ItIcon name="it-file" />
            </span>
            <a
              class="attachments-box__link"
              href={createDownloadUrl(download.doc!)}
              download
            >
              {download.label ?? download.doc!.filename}
            </a>
            <span class="attachments-box__meta">{dettagli(download.doc!)}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .attachments-box {
    margin-block: 2rem;
    border-radius: 8px;
    padding: 2rem;
  }

  .attachments-box--default {
    border-radius: 0;
    padding: 0;
  }

  .attachments-box--lighter {
    background: var(--color-blue-97, #f2f7fc);
  }

  .attachments-box--primary-light {
    background: #bfdfff;
  }

  .attachments-box--primary {
    background: #06c;
  }

  .attachments-box--dark {
    background: #17324d;
  }

  .attachments-box__title {
    margin-bottom: 1.5rem;
    color: var(--color-text-base, #1a1a1a);
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-size: 40px;
    font-weight: 700;
    line-height: 48px;
  }

  .attachments-box--primary .attachments-box__title,
  .attachments-box--dark .attachments-box__title {
    color: #fff;
  }

  .attachments-box__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .attachments-box__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
  }

  .attachments-box__item + .attachments-box__item {
    border-top: 1px solid var(--color-border-subtle, #c5c7c9);
  }

  .attachments-box--primary .attachments-box__item + .attachments-box__item,
  .attachments-box--dark .attachments-box__item + .attachments-box__item {
    border-top-color: rgb(255 255 255 / 0.25);
  }

  .attachments-box__icon :global(svg) {
    display: block;
    width: 1.5rem;
    height: 1.5rem;
    fill: var(--color-text-primary, #06c);
  }

  .attachments-box--primary .attachments-box__icon :global(svg),
  .attachments-box--dark .attachments-box__icon :global(svg) {
    fill: #fff;
  }

  .attachments-box__link {
    color: var(--color-text-primary, #06c);
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-size: 24px;
    font-weight: 600;
    line-height: 32px;
    text-decoration-line: underline;
    text-decoration-skip-ink: none;
    text-underline-position: from-font;
  }

  .attachments-box--primary .attachments-box__link,
  .attachments-box--dark .attachments-box__link {
    color: #fff;
  }

  .attachments-box__meta {
    color: var(--color-text-secondary, #5b6f82);
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .attachments-box--primary .attachments-box__meta,
  .attachments-box--dark .attachments-box__meta {
    color: #fff;
  }
</style>
