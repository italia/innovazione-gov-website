---
import { WideLinkCard } from "@components/molecules/WideLinkCard";
import type { WideLinkCardFragmentType } from "@graphql/fragment/commonFragments";
import { linkResolver } from "@utils/linkResolver";

type Props = {
  block: WideLinkCardFragmentType;
  variant?: "default" | "compact";
};

const { block, variant = "default" } = Astro.props;
const { lang } = Astro.locals;

const article = block.article ?? null;

const externalUrl = block.link?.externalUrl ?? null;
const internalId = block.link?.link?.id ?? article?.id ?? null;
const linkTo =
  externalUrl || (internalId ? linkResolver(internalId, lang) : null);

const title = block.title || article?.title || "";
const paragraph =
  block.paragraph || article?.paragraph || article?.description || null;
const isCompact = variant === "compact";
const image =
  block.image ??
  (isCompact ? (article?.logo ?? article?.image) : article?.image) ??
  undefined;
const fitImage = block.image ? "contain" : "cover";
const category = block.category || article?.tags?.[0]?.name || null;
const dateTime = article
  ? (article.dateShown ?? article.firstPublishedAt ?? null)
  : null;
---

<WideLinkCard
  title={title}
  paragraph={paragraph}
  category={category}
  image={image}
  linkTo={linkTo}
  fitImage={fitImage}
  isExternal={!!externalUrl}
  dateTime={dateTime}
  variant={variant}
  imageBackground={block.imageBackground === "blu" ? "blu" : "chiaro"}
/>
