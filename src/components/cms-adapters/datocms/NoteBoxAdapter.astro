---
import { NoteBox } from "@components/molecules/NoteBox";
import type { NoteBoxFragmentType } from "@graphql/fragment/commonFragments";

type DatoRecord = NoteBoxFragmentType & {
  __typename: string;
  id: string;
};

type Props = {
  block: DatoRecord;
};

const { block } = Astro.props;
---

<NoteBox title={block.title} paragraph={block.paragraph} />
