---
import type { CardEditorialWithIconProps } from "@components/molecules/CardEditorialWithIcon/types";
import { ListCard } from "@components/molecules/ListCard";
import type { ListCardEditorialWithIconFragmentType } from "@graphql/fragment/commonFragments";

type DatoRecord = ListCardEditorialWithIconFragmentType & {
  __typename: string;
  id: string;
};

type Props = {
  block: DatoRecord;
};

const { block } = Astro.props;

const cardsData: CardEditorialWithIconProps[] = block?.items.map((item) => {
  return {
    title: item.title,
    description: item.description,
    icon: item.iconSelect,
  };
});
---

{block.title && <h3 class="list-card-label">{block.title}</h3>}
<ListCard cards={cardsData} type="CardEditorialWithIcon" fullWidth />

<style>
  .list-card-label {
    margin-top: 3rem;
    margin-bottom: 16px;
    font-weight: 600;
    font-size: 16px;
    line-height: 24px;
  }
</style>
