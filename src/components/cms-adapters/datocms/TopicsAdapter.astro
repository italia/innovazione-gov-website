---
import { Topics } from "@components/molecules/Topics";
import type { TopicsBlockFragmentType } from "@graphql/fragment/commonFragments";
import { topicLinks } from "@utils/topicRoutes";

type DatoRecord = TopicsBlockFragmentType & {
  __typename: string;
  id: string;
};

type Props = {
  block: DatoRecord;
};

const { block } = Astro.props;
const { lang } = Astro.locals;
---

<Topics
  title={block.title || undefined}
  topics={block.topics
    .map((topic) => topic.name)
    .filter((name): name is string => !!name)}
  links={topicLinks(block.topics, lang)}
/>
