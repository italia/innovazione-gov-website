---
import type { CardEditorialNewsProps } from "@components/molecules/CardEditorialNews/types";
import { ArchiveList } from "@components/organisms/ArchiveList";
import { ListCollection } from "@components/organisms/ListCollection";
import { ListOpenPositions } from "@components/organisms/ListOpenPositions";
import { ListWideCards } from "@components/organisms/ListWideCards";
import type { CardLinkListFragmentType } from "@graphql/fragment/sectionFragments";
import type { SiteLocale } from "@graphql/types";
import { isDraftModeEnabled } from "@lib/draftMode";
import { getLastItems } from "@lib/lastItems";
import { getOpenPositions } from "@lib/openPositions";
import type { SectionBackground } from "@utils/background";
import { getCtaFields } from "@utils/getCtaFields";
import { linkResolver } from "@utils/linkResolver";

type Props = {
  block: CardLinkListFragmentType;
};

const { block } = Astro.props;
const { lang } = Astro.locals;

const isPreview = import.meta.env.DEV && isDraftModeEnabled(Astro.cookies);

const categoryIds = block.category ? [block.category.id] : [];
const onlyOneCategory = categoryIds.length > 0;
const showCategoryFilter = block.showFilterOnCategory ?? false;

const TUTTE = 1000;
const quanteSchede = block.cardsCount ?? null;
const limite =
  quanteSchede === 0
    ? TUTTE
    : quanteSchede !== null
      ? quanteSchede
      : onlyOneCategory || showCategoryFilter
        ? 60
        : 3;

const cardOrizzontali = (block.listContent ?? []).filter(
  (item) => item.componentName === "WideLinkCardRecord",
);

const mostraPosizioniAperte = block.lastItems === "job_position";

const posizioniAperte = mostraPosizioniAperte
  ? await getOpenPositions(lang as SiteLocale)
  : [];

let items: CardEditorialNewsProps[];

if (mostraPosizioniAperte) {
  items = [];
} else if (cardOrizzontali.length > 0) {
  items = [];
} else if (block.lastItems) {
  items = await getLastItems(block.lastItems, {
    locale: lang as SiteLocale,
    includeDrafts: isPreview,
    limit: limite,
    categoryIds,
    onlyArchived: block.onlyArchived ?? false,
  });
} else {
  items = (block.listContent ?? [])
    .filter((item) => item.componentName === "CardLinkRecord")
    .map((item) => {
      const url = item.link?.externalUrl;
      const linkTo = item.link?.link?.id
        ? linkResolver(item.link.link.id, lang)
        : null;

      return {
        id: item.id,
        title: item.title ?? "",
        description: item.paragraph || "",
        image: item.image ?? undefined,
        linkTo: url || linkTo || "#",
        action: url ? new URL(url).host : undefined,
        isExternal: !!url,
      };
    });
}

const categoriaFissata = block.category?.name ?? null;
const senzaCategoriaFissata = (voci: CardEditorialNewsProps[]) =>
  categoriaFissata === null
    ? voci
    : voci.map((voce) => ({
        ...voce,
        filterCategories: (voce.filterCategories ?? []).filter(
          (nome) => nome !== categoriaFissata,
        ),
      }));

const { labelButton, linkTo, openInNewTab } = getCtaFields(
  (block.cta as Parameters<typeof getCtaFields>[0]) ?? null,
  lang as SiteLocale,
);
---

{
  mostraPosizioniAperte ? (
    <ListOpenPositions
      title={block.title ?? ""}
      paragraph={block.paragraph}
      items={posizioniAperte}
      background={block.backgroundColor as SectionBackground}
      labelButton={labelButton}
      linkTo={linkTo}
      openInNewTab={openInNewTab}
    />
  ) : cardOrizzontali.length > 0 ? (
    <ListWideCards
      title={block.title ?? ""}
      paragraph={block.paragraph}
      cards={cardOrizzontali}
      background={block.backgroundColor as SectionBackground}
    />
  ) : block.onlyArchived ? (
    items.length > 0 && (
      <ArchiveList
        title={block.title ?? ""}
        paragraph={block.paragraph}
        items={items}
        background={block.backgroundColor as SectionBackground}
        labelButton={labelButton}
        linkTo={linkTo}
        openInNewTab={openInNewTab}
      />
    )
  ) : (
    items.length > 0 && (
      <ListCollection
        title={block.title ?? ""}
        items={senzaCategoriaFissata(items)}
        paragraph={block.paragraph || undefined}
        background={block.backgroundColor as SectionBackground}
        showInline={block.showInlineCard ?? undefined}
        showCategoryFilter={showCategoryFilter}
        visibleCount={onlyOneCategory ? items.length : undefined}
        labelButton={labelButton}
        linkTo={linkTo}
        openInNewTab={openInNewTab}
      />
    )
  )
}
