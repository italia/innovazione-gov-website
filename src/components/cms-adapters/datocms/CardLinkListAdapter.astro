---
import type { CardEditorialNewsProps } from "@components/molecules/CardEditorialNews/types";
import { ListCollection } from "@components/organisms/ListCollection";
import type { CardLinkListFragmentType } from "@graphql/fragment/sectionFragments";
import type { SectionBackground } from "@utils/background";
import { linkResolver } from "@utils/linkResolver";

type Props = {
  block: CardLinkListFragmentType;
};

const { block } = Astro.props;
const { lang } = Astro.locals;

// Fields may be absent when staging DatoCMS schema is behind main
const fullBlock = block as typeof block & {
  listContent?: Array<{
    id: string;
    title?: string | null;
    paragraph?: string | null;
    image?: {
      url: string;
      alt?: string | null;
      width: number | null;
      height: number | null;
    } | null;
    link?: { link?: { id: string } | null; externalUrl?: string | null } | null;
  }> | null;
  title?: string | null;
  paragraph?: string | null;
  backgroundColor?: string | null;
  showInlineCard?: boolean | null;
};

if (!fullBlock.listContent?.length) return;

const items: CardEditorialNewsProps[] = fullBlock.listContent.map((item) => {
  const url = item.link?.externalUrl;
  const linkTo = item.link?.link?.id
    ? linkResolver(item.link.link.id, lang)
    : null;

  return {
    id: item.id,
    title: item.title ?? "",
    description: item.paragraph || "",
    image: item.image ?? undefined,
    linkTo: url || linkTo || "#",
    action: url ? new URL(url).host : undefined,
    isExternal: !!url,
  };
});
---

<ListCollection
  title={fullBlock.title ?? ""}
  items={items}
  paragraph={fullBlock.paragraph || undefined}
  background={fullBlock.backgroundColor as SectionBackground}
  showInline={fullBlock.showInlineCard ?? undefined}
/>
