---
import StructuredTextAdapter from "@components/cms-adapters/datocms/StructuredTextAdapter.astro";
import { ArticleAttachments } from "@components/organisms/ArticleAttachments";
import { ArticleToc } from "@components/organisms/ArticleToc";
import { ArticleUsefulLinks } from "@components/organisms/ArticleUsefulLinks";
import type { ArticleSTFragmentType } from "@graphql/fragment/sectionFragments";
import { getI18n } from "@i18n/microcopy";
import { getSectionBgClass, type SectionBackground } from "@utils/background";
import { extractHeadings } from "@utils/extractHeadings";
import { slugify } from "@utils/slugify";

type Attachment = {
  id: string;
  fileTitle?: string | null;
  file?: { url: string; filename: string; format: string } | null;
};
type ExternalLink = {
  id: string;
  title?: string | null;
  link?: string | null;
  description?: string | null;
};

type Props = {
  block: ArticleSTFragmentType;
  attachments?: Attachment[];
  links?: ExternalLink[];
};

const { block, attachments = [], links = [] } = Astro.props;
const { lang } = Astro.locals;
const t = getI18n(lang);

const background = block.backgroundColor || "default";
const bgClass = getSectionBgClass(background as SectionBackground);

const fontClass = block.fontSerif ? "font-serif-p" : "";

// Indice della pagina: acceso dal redattore sul singolo blocco (campo
// `show_page_index` su DatoCMS). Le voci sono i titoli di livello 2 di questo
// blocco; le ancore esistono già perché HeadingAdapter mette id={slugify(testo)}
// su ogni heading. Gli articoli usano invece l'h3 (vedi SidebarLayoutAdapter).
const tocItems = block.showPageIndex
  ? extractHeadings(block.textContent?.value, [2]).map((heading) => ({
      id: heading.id,
      label: heading.text,
    }))
  : [];

if (tocItems.length && attachments.some((attachment) => attachment.file))
  tocItems.push({
    id: slugify(t["resources.title"]),
    label: t["resources.title"],
  });

if (tocItems.length && links.some((link) => link.link))
  tocItems.push({ id: slugify(t["links.title"]), label: t["links.title"] });

const hasToc = tocItems.length > 0;
---

<section class={bgClass}>
  <div
    class:list={[
      "structured-text-container",
      "structured-text-block",
      fontClass,
      { "has-page-index": hasToc },
    ]}
  >
    <div class:list={["container", { "py-5 py-lg-80": !hasToc }]}>
      <div class="row">
        {
          hasToc && (
            <div class="col-12 col-lg-4 px-lg-0 py-5 py-lg-80 border-end">
              <ArticleToc header={t["toc.title"]} items={tocItems} />
            </div>
          )
        }
        {
          /* ps-lg-4 stacca il testo dalla linea verticale dell'indice, come fa
            ArticleAdapter sulle pagine articolo. */
        }
        <div
          class:list={[
            "col-12",
            hasToc ? "col-lg-8 ps-lg-4 py-5 py-lg-80" : "col-lg-8",
          ]}
        >
          <StructuredTextAdapter block={block.textContent} />
          <ArticleAttachments attachments={attachments} />
          <ArticleUsefulLinks links={links} />
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* L'header è sticky: senza questo, cliccando una voce dell'indice il titolo
     finisce sotto la navbar. Sulle pagine articolo lo dichiara
     SidebarLayoutAdapter, qui serve per pagine e sottopagine. */
  .structured-text-block :is(h1, h2, h3, h4, h5, h6) {
    scroll-margin-top: 7rem;
  }
</style>
