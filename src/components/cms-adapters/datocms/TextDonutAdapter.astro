---
import TextContainerAdapter from "@components/cms-adapters/datocms/TextContainerAdapter.astro";
import type { HeadingTag } from "@components/molecules/TextContainer/types";
import { TextDonut } from "@components/organisms/TextDonut";
import type { TextDonutFragmentType } from "@graphql/fragment/sectionFragments";
import type { SectionBackground } from "@utils/background";

type Props = {
  block: TextDonutFragmentType;
};

const { block } = Astro.props;

const variantTextContainer =
  block.backgroundColor === "dark"
    ? "dark"
    : block.backgroundColor === "primary"
      ? "primary"
      : "light";
---

<TextDonut
  label={block.label || undefined}
  percentage={block.percentage}
  description={block.description || undefined}
  background={block.backgroundColor as SectionBackground}
  sectionTitleId={block.text.title}
  altText="Infografico dimostra che il Dipartimento per la trasformazione digitale ha raggiunto il 99% degli obiettivi del PNRR."
>
  <TextContainerAdapter
    slot="text"
    block={block.text}
    variant={variantTextContainer}
    heading={(block.heading as HeadingTag) || undefined}
  />
</TextDonut>
