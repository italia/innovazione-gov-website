---
import StructuredTextAdapter from "@components/cms-adapters/datocms/StructuredTextAdapter.astro";
import { ArticleAttachments } from "@components/organisms/ArticleAttachments";
import { ArticleUsefulLinks } from "@components/organisms/ArticleUsefulLinks";
import { SectionContainer } from "@components/organisms/SectionContainer";
import type { ArticleContentFragmentType } from "@graphql/fragment/article";

type Attachment = {
  id: string;
  fileTitle?: string | null;
  file?: { url: string; filename: string; format: string } | null;
};
type ExternalLink = {
  id: string;
  title?: string | null;
  link?: string | null;
  description?: string | null;
};

type Props = {
  content: ArticleContentFragmentType;
  attachments?: Attachment[];
  links?: ExternalLink[];
};

const { content, attachments = [], links = [] } = Astro.props;
---

<SectionContainer className="ps-lg-4 structured-text-container">
  <StructuredTextAdapter block={content} />
  <ArticleAttachments attachments={attachments} />
  <ArticleUsefulLinks links={links} />
</SectionContainer>
