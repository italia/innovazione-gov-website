---
import StructuredTextAdapter from "@components/cms-adapters/datocms/StructuredTextAdapter.astro";
import { SectionContainer } from "@components/organisms/SectionContainer";
import type { ArticleContentFragmentType } from "@graphql/fragment/article";

type Props = {
  content: ArticleContentFragmentType;
  fullWidth?: boolean;
  articleType?: string | null;
};

const { content, fullWidth = false, articleType } = Astro.props;
const classeFocus = articleType === "focus" ? " article-body--focus" : "";
---

<SectionContainer
  className={`structured-text-container font-serif-p article-body${classeFocus}${fullWidth ? " structured-text-container--narrow" : " ps-lg-4"}`}
>
  <StructuredTextAdapter block={content} />
</SectionContainer>
