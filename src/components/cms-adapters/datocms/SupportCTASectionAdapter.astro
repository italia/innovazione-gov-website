---
import type {
  SupportCTASectionBackgroundProps,
  SupportCTASectionSizeProps,
} from "@components/organisms/SupportCTASection/types";
import type { SupportCTASectionFragmentType } from "@graphql/fragment/sectionFragments";
import { getCtaFields } from "@utils/getCtaFields";
import { SupportCTASection } from "../../organisms/SupportCTASection";

type DatoRecord = SupportCTASectionFragmentType & {
  __typename: string;
  id: string;
};

type Props = {
  block: DatoRecord | SupportCTASectionFragmentType;
  size?: SupportCTASectionSizeProps;
};

const { block, size = "small" } = Astro.props;
const { lang } = Astro.locals;

// Fields may be absent when staging DatoCMS schema is behind main
const fullBlock = block as typeof block & {
  title?: string | null;
  paragraph?: string | null;
  backgroundColor?: string | null;
  image?: {
    url: string;
    alt?: string | null;
    width: number | null;
    height: number | null;
  } | null;
  cta?: unknown;
};

if (!fullBlock.title || !fullBlock.paragraph || !fullBlock.image) return;

const { labelButton, linkTo, openInNewTab } = getCtaFields(
  (fullBlock.cta as Parameters<typeof getCtaFields>[0]) ?? null,
  lang,
);
---

<SupportCTASection
  title={fullBlock.title!}
  paragraph={fullBlock.paragraph!}
  image={fullBlock.image!}
  size={size}
  background={fullBlock.backgroundColor as SupportCTASectionBackgroundProps}
  labelButton={labelButton}
  linkTo={linkTo}
  openInNewTab={openInNewTab}
/>
