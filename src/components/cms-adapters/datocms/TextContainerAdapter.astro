---
import { TextContainer } from "@components/molecules/TextContainer";
import type {
  HeadingTag,
  TextContainerVariant,
} from "@components/molecules/TextContainer/types";
import type { TextBlockFragmentType } from "@graphql/fragment/commonFragments";
import { getCtaFields } from "@utils/getCtaFields";

type Props = {
  block: TextBlockFragmentType;
  variant: TextContainerVariant;
  heading?: HeadingTag;
  hideCta?: boolean;
};

const { block, variant, heading = "h2", hideCta = false } = Astro.props;
const { lang } = Astro.locals;

const { labelButton, linkTo, openInNewTab } = getCtaFields(block.cta, lang);
const secondaria = getCtaFields(block.ctaSecondary, lang);
---

<TextContainer
  title={block.title}
  paragraph={block.paragraph}
  variant={variant}
  labelButton={hideCta ? undefined : labelButton}
  linkTo={hideCta ? undefined : linkTo}
  openInNewTab={openInNewTab}
  labelButtonSecondary={hideCta ? undefined : secondaria.labelButton}
  linkToSecondary={hideCta ? undefined : secondaria.linkTo}
  openInNewTabSecondary={secondaria.openInNewTab}
  heading={heading}
/>
