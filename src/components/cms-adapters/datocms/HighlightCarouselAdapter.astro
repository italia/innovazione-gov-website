---
import { HighlightCarousel } from "@components/organisms/HighlightCarousel";
import type { HighlightCarouselFragmentType } from "@graphql/fragment/sectionFragments";
import { linkResolver } from "@utils/linkResolver";

type Props = {
  block: HighlightCarouselFragmentType;
};

const { block } = Astro.props;
const { lang } = Astro.locals;

const slides = (block.items ?? [])
  .filter((item) => item.pointsTo)
  .map((item) => {
    const collegato = item.pointsTo!;
    const titolo =
      item.label ?? ("title" in collegato ? collegato.title : "") ?? "";
    const testo =
      item.paragraph ??
      ("articleParagraph" in collegato ? collegato.articleParagraph : null);
    const immagine =
      item.image ??
      ("articleImage" in collegato ? collegato.articleImage : null);
    return {
      id: item.id,
      title: titolo,
      paragraph: testo,
      image: immagine,
      linkTo: linkResolver(collegato.id, lang),
    };
  })
  .filter((slide) => slide.title);
---

{slides.length > 0 && <HighlightCarousel title={block.title} slides={slides} />}
