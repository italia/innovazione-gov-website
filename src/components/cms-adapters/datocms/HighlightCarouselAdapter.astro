---
import { HighlightCarousel } from "@components/organisms/HighlightCarousel";
import type { HighlightCarouselFragmentType } from "@graphql/fragment/sectionFragments";
import { toSectionBackground } from "@utils/background";
import { linkResolver } from "@utils/linkResolver";
import { contentLabel, isActivityType } from "@utils/storyClassification";
import { topicLinks } from "@utils/topicRoutes";

type Props = {
  block: HighlightCarouselFragmentType;
};

const { block } = Astro.props;
const { lang } = Astro.locals;

const mostraData = !block.hideDate;
const mostraArgomenti = !block.hideTopics;

const slides = (block.items ?? [])
  .filter((item) => item.pointsTo)
  .map((item) => {
    const collegato = item.pointsTo!;
    const titolo =
      item.label || ("title" in collegato ? collegato.title : "") || "";
    const testo =
      item.paragraph ||
      ("articleParagraph" in collegato ? collegato.articleParagraph : null);
    const immagine =
      item.image ??
      ("articleImage" in collegato ? collegato.articleImage : null);
    const tipo = "articleType" in collegato ? collegato.articleType : null;
    const attivita = isActivityType(tipo);
    const tag = "tags" in collegato ? collegato.tags : [];
    return {
      id: item.id,
      title: titolo,
      paragraph: testo,
      image: immagine,
      badge: contentLabel(
        tipo,
        "contentType" in collegato ? collegato.contentType : null,
      ),
      dateTime:
        attivita || !mostraData || !("dateShown" in collegato)
          ? null
          : (collegato.dateShown ?? collegato.articleFirstPublishedAt ?? null),
      topics:
        attivita || !mostraArgomenti
          ? []
          : tag.map((t) => t.name).filter((name): name is string => !!name),
      topicLinks: attivita || !mostraArgomenti ? {} : topicLinks(tag, lang),
      linkTo: linkResolver(collegato.id, lang),
    };
  })
  .filter((slide) => slide.title);
---

{
  slides.length > 0 && (
    <HighlightCarousel
      title={block.title}
      slides={slides}
      background={toSectionBackground(block.backgroundColor)}
    />
  )
}
