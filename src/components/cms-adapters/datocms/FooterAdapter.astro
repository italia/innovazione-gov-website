---
import { getArgomentiInEvidenza } from "@lib/argomentiInEvidenza";
import { Footer } from "@components/organisms/Footer";
import type {
  FooterColumnProps,
  FooterContactsProps,
  FooterLinkProps,
  FooterLinkSupportingBrandProps,
  MailingListFormProps,
} from "@components/organisms/Footer/types";
import type { FooterFragmentType } from "@graphql/fragment/layout";
import type { SiteLocale } from "@graphql/types";
import { DatoBlockModel } from "@utils/cmsMapper";
import { getLocaleValue } from "@utils/getLocaleValue";
import { linkResolver } from "@utils/linkResolver";

type Props = FooterFragmentType & {
  logoSelect?: string | null;
  siteName?: string | null;
  homeRecordId?: string;
};

const {
  _allUtilityTitleLocales,
  _allUtilityLocales,
  _allSmallPrintLocales,
  _allContactTitleLocales,
  _allContactAddressLocales,
  _allFooterColumnsLocales,
  _allMailingListFormLocales,
  showSitemapLink,
  logoSelect,
  siteName,
  homeRecordId,
} = Astro.props;

const { lang } = Astro.locals;

const utilityTitle = getLocaleValue(_allUtilityTitleLocales, lang, "") ?? "";
const utility = getLocaleValue(_allUtilityLocales, lang, null);
const smallPrint = getLocaleValue(_allSmallPrintLocales, lang, null);
const mailingList = getLocaleValue(_allMailingListFormLocales, lang, null);
const contactTitle = getLocaleValue(_allContactTitleLocales, lang, null);
const contactAddress = getLocaleValue(_allContactAddressLocales, lang, null);
const footerColumns = getLocaleValue(_allFooterColumnsLocales, lang, null);

const escapeHtml = (text: string) =>
  text
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");

const contacts: FooterContactsProps | undefined = contactAddress?.trim()
  ? {
      title: contactTitle ?? "",
      address: escapeHtml(contactAddress.trim()).replace(/\r?\n/g, "<br />"),
      icon: "it-pa",
    }
  : undefined;

const socialItems: FooterLinkSupportingBrandProps[] =
  utility
    ?.filter((util) => util.componentName === DatoBlockModel.SupportingBrand)
    .map((util) => ({
      label: util.label,
      icon: util.brandLogo,
      url: util.url,
    })) || [];

type CmsLink = NonNullable<typeof smallPrint>[number];

const toFooterLink = (link: CmsLink): FooterLinkProps => {
  if (link.componentName === DatoBlockModel.ExternalLink) {
    return { label: link.label, url: link.url };
  }
  const path = linkResolver(link.linkTo?.id, lang);
  const anchor = link.anchor?.trim();

  return {
    label: link.label,
    linkTo: anchor && path !== "#" ? `${path}#${anchor}` : path,
  };
};

const columns: FooterColumnProps[] =
  footerColumns
    ?.map((column) => ({
      title: column.title ?? "",
      links: column.links.map(toFooterLink),
    }))
    .filter((column) => column.links.length > 0) || [];

const smallPrints: FooterLinkProps[] = smallPrint?.map(toFooterLink) || [];

const ARGOMENTI_NEL_FOOTER = 5;

const argomenti = (await getArgomentiInEvidenza(lang as SiteLocale))
  .slice(0, ARGOMENTI_NEL_FOOTER)
  .map((argomento) => ({ name: argomento.name, path: argomento.path }));

const mailingListForm: MailingListFormProps | undefined = mailingList
  ? {
      title: mailingList.title,
      privacyPolicy: {
        label: mailingList.privacyPolicy.label,
        linkTo: linkResolver(mailingList.privacyPolicy.linkTo.id, lang),
      },
    }
  : undefined;
---

<Footer
  topics={argomenti}
  brand={{
    logo: logoSelect
      ? { url: logoSelect, width: null, height: null }
      : undefined,
    name: siteName ?? "",
    linkTo: linkResolver(homeRecordId, lang),
  }}
  contacts={contacts}
  social={{ title: utilityTitle, items: socialItems }}
  columns={columns}
  mailingListForm={mailingListForm}
  smallPrints={{ links: smallPrints, showSitemap: showSitemapLink }}
/>
