---
import ArticleAdapter from "@components/cms-adapters/datocms/ArticleAdapter.astro";
import { ArticleToc } from "@components/organisms/ArticleToc";
import type { ArticleContentFragmentType } from "@graphql/fragment/article";
import type { SidebarFragmentType } from "@graphql/fragment/layout";
import { getI18n } from "@i18n/microcopy";
import { extractHeadings } from "@utils/extractHeadings";
import { slugify } from "@utils/slugify";

type Attachment = {
  id: string;
  fileTitle?: string | null;
  file?: { url: string; filename: string; format: string } | null;
};
type ExternalLink = {
  id: string;
  title?: string | null;
  link?: string | null;
  description?: string | null;
};

type Props = {
  sidebar: SidebarFragmentType;
  content: ArticleContentFragmentType;
  attachments?: Attachment[];
  links?: ExternalLink[];
};

const { content, attachments = [], links = [] } = Astro.props;
const { lang } = Astro.locals;
const t = getI18n(lang);

const headings = extractHeadings(content.value, [3]);
const tocItems = headings.map((heading) => ({
  id: heading.id,
  label: heading.text,
}));

if (attachments.some((attachment) => attachment.file)) {
  tocItems.push({
    id: slugify(t["resources.title"]),
    label: t["resources.title"],
  });
}

if (links.some((externalLink) => externalLink.link)) {
  tocItems.push({
    id: slugify(t["links.title"]),
    label: t["links.title"],
  });
}
---

<div class="container">
  <div class="row">
    <div class="col-12 col-lg-4 px-lg-0 pb-lg-5 border-end menu-column">
      {
        tocItems.length > 0 && (
          <ArticleToc header={t["toc.title"]} items={tocItems} />
        )
      }
    </div>
    <div class="col-12 col-lg-8 px-lg-0">
      <ArticleAdapter
        content={content}
        attachments={attachments}
        links={links}
      />
    </div>
  </div>
</div>

<style>
  .menu-column {
    padding-top: 3rem;
  }
  @media (min-width: 992px) {
    .menu-column {
      padding-top: 5rem;
    }
  }
</style>

<style is:global>
  .structured-text-container :is(h1, h2, h3, h4, h5, h6) {
    scroll-margin-top: 7rem;
  }
  .structured-text-container :is(h2, h3) {
    font-size: 2.5rem;
    line-height: 1.2;
  }
</style>
