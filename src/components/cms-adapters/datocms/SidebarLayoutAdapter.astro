---
import ArticleAdapter from "@components/cms-adapters/datocms/ArticleAdapter.astro";
import { ArticleToc } from "@components/organisms/ArticleToc";
import type { ArticleContentFragmentType } from "@graphql/fragment/article";
import type { SidebarFragmentType } from "@graphql/fragment/layout";
import { getI18n } from "@i18n/microcopy";
import { extractIndice } from "@utils/extractHeadings";

type Props = {
  sidebar: SidebarFragmentType;
  content: ArticleContentFragmentType;
  showSidebar?: boolean;
  articleType?: string | null;
};

const { content, showSidebar = true, articleType } = Astro.props;
const { lang } = Astro.locals;
const t = getI18n(lang);

const headings = extractIndice(content.value, content.blocks ?? []);
const tocItems = headings.map((heading) => ({
  id: heading.id,
  label: heading.text,
}));
const hasToc = tocItems.length > 0;
---

{
  showSidebar && hasToc ? (
    <div class="container">
      <div class="row">
        <div class="col-12 col-lg-4 px-lg-0 pb-lg-5 border-end menu-column">
          <ArticleToc header={t["toc.title"]} items={tocItems} />
        </div>
        <div class="col-12 col-lg-8 px-lg-0">
          <ArticleAdapter content={content} articleType={articleType} />
        </div>
      </div>
    </div>
  ) : (
    <ArticleAdapter content={content} articleType={articleType} fullWidth />
  )
}

<style>
  .menu-column {
    padding-top: 3rem;
  }
  @media (min-width: 992px) {
    .menu-column {
      padding-top: 5rem;
    }
  }
</style>

<style is:global>
  .structured-text-container :is(h1, h2, h3, h4, h5, h6) {
    scroll-margin-top: 7rem;
  }
  .structured-text-container :is(h2, h3) {
    font-size: 2.5rem;
    line-height: 1.2;
  }
</style>
