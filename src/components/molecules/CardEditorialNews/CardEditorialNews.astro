---
import { DateTime } from "@components/atoms/DateTime";
import { Image } from "@components/atoms/Image";
import { getI18n } from "@i18n/microcopy";
import ItExternalLink from "@static/assets/ItExternalLink.astro";
import type { CardEditorialNewsProps } from "./types";

type Props = CardEditorialNewsProps;

const {
  id = "",
  title,
  description,
  image,
  linkTo,
  category,
  dateTime,
  action,
  categoryLinks = {},
  fullHeight = true,
  isExternal = true,
  imageFit = "cover",
} = Astro.props;

const categories = Array.isArray(category)
  ? category.filter(Boolean)
  : category
    ? [category]
    : [];
const shouldShowFooter = categories.length > 0 || dateTime;
const hasLink = !!linkTo && linkTo !== "#";
const cardTitleId = `card-title-${id}`;
const { lang } = Astro.locals;
const t = getI18n(lang);

const ariaLabel = isExternal ? t["link.external"] : t["link.internal"];
const target = isExternal ? "_blank" : "_self";
const rel = isExternal ? "noopener noreferrer" : undefined;
---

<article
  class=`it-card it-card-image ${fullHeight && "it-card-height-full"}`
  aria-labelledby={cardTitleId}
>
  <h3 class="it-card-title" id={cardTitleId}>
    {
      hasLink ? (
        <a href={linkTo} target={target} rel={rel}>
          {title}
          <span class="visually-hidden">{ariaLabel}</span>
          {isExternal && <ItExternalLink color="primary" size="sm" />}
        </a>
      ) : (
        <span>{title}</span>
      )
    }
  </h3>
  {
    image && (
      <div
        class:list={[
          "it-card-image-wrapper",
          imageFit === "contain" && "it-card-image-wrapper--logo",
        ]}
      >
        <div class="ratio ratio-16x9">
          <figure class="figure img-full">
            <Image {...image} />
          </figure>
        </div>
      </div>
    )
  }
  <div class="it-card-body">
    <p class="it-card-text">{description}</p>
  </div>
  {
    shouldShowFooter && (
      <footer class="it-card-related it-card-footer">
        {categories.length > 0 && (
          <div class="it-card-taxonomy d-flex flex-wrap gap-2">
            <span class="visually-hidden">{t["card.topic"]}</span>
            {categories.map((c) =>
              categoryLinks[c] ? (
                <a class="chip chip-simple chip-link" href={categoryLinks[c]}>
                  <span class="chip-label">{c}</span>
                </a>
              ) : (
                <div class="chip chip-simple">
                  <span class="chip-label">{c}</span>
                </div>
              ),
            )}
          </div>
        )}
        {dateTime && <DateTime className="it-card-date" value={dateTime} />}
      </footer>
    )
  }
  {action && <div class="it-card-footer">{action}</div>}
</article>

<style>
  .it-card {
    border: 1px solid var(--color-border-subtle, #c5c7c9);
    border-radius: 4px;
    box-shadow: 0 4px 4px 0 rgb(0 0 0 / 15%);
  }

  .it-card-image-wrapper--logo :global(figure img) {
    object-fit: contain !important;
  }

  .it-card-taxonomy .chip:not(.chip-link) {
    pointer-events: none;
  }

  .it-card-taxonomy .chip-link {
    text-decoration: none;
  }

  .it-card-taxonomy .chip-link .chip-label {
    color: var(--color-text-secondary, #2f475e);
  }

  .it-card-taxonomy .chip-link:hover,
  .it-card-taxonomy .chip-link:focus-visible {
    border-color: var(--color-text-primary, #06c);
    background: var(--color-text-primary, #06c);
  }

  .it-card-taxonomy .chip-link:hover .chip-label,
  .it-card-taxonomy .chip-link:focus-visible .chip-label {
    color: #fff;
    text-decoration: underline;
  }
</style>
