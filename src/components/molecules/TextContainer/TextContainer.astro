---
import { ButtonLink } from "@components/atoms/Button";
import { slugify } from "@utils/slugify";
import type { TextContainerProps } from "./types";

type Props = TextContainerProps;

const {
  title,
  paragraph,
  labelButton,
  linkTo,
  labelButtonSecondary,
  linkToSecondary,
  openInNewTabSecondary = false,
  variant = "light",
  heading: TitleTag = "h2",
  openInNewTab = false,
} = Astro.props;

const colorClass =
  variant === "dark" || variant === "primary" ? "text-white" : "";

const variantButton =
  variant === "primary"
    ? "outline-dark"
    : variant === "dark"
      ? "dark"
      : undefined;
---

<style is:global>
  @import "./style.scss";
</style>
<div class=`text-container mb-4 mb-lg-0 ${colorClass}`>
  <TitleTag class="mb-3" id={slugify(title)}>
    {title}
  </TitleTag>
  <Fragment set:html={paragraph} />
  {
    labelButton && linkTo && (
      <div class="text-container__actions mt-4">
        <ButtonLink
          size="small"
          label={labelButton}
          variant={variantButton}
          linkTo={linkTo}
          openInNewTab={openInNewTab}
          icon={openInNewTab ? "it-external-link" : undefined}
        />
        {labelButtonSecondary && linkToSecondary && (
          <ButtonLink
            size="small"
            label={labelButtonSecondary}
            variant={
              variantButton === "dark" ? "outline-dark" : "outline-light"
            }
            linkTo={linkToSecondary}
            openInNewTab={openInNewTabSecondary}
            icon={openInNewTabSecondary ? "it-external-link" : undefined}
          />
        )}
      </div>
    )
  }
</div>

<style>
  .text-container__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
