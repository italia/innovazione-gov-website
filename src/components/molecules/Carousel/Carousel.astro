---
type Props = {
  className?: string;
};

const { className = "" } = Astro.props;
---

<div
  class:list={[
    "it-carousel-wrapper it-carousel-landscape-abstract splide d-block d-lg-none",
    className,
  ]}
  data-bs-carousel-splide
>
  <div class="splide__track ps-lg-3 pe-lg-3">
    <ul class="splide__list it-carousel-all">
      <slot />
    </ul>
  </div>
</div>
