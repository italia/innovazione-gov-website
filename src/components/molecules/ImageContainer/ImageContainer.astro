---
import { Image } from "@components/atoms/Image";
import type { ImageContainerProps } from "./types";

type Props = ImageContainerProps;

const { ratio = "4x3", image } = Astro.props;
---

<div class:list={["image-container", "ratio", `ratio-${ratio}`]}>
  <Image {...image} />
</div>

<style>
  .image-container :global(img) {
    object-fit: cover;
    object-position: center;
  }
</style>
