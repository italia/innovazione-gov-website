---
import { IconContainer } from "@components/atoms/IconContainer";
import type {
  DataContainerProps,
  VariantTextDataContainerProps,
} from "./types";

type Props = DataContainerProps & { variant?: VariantTextDataContainerProps };

const { info, title, contentIcon, variant = "light" } = Astro.props;

const colorClass = variant === "dark" ? "text-white" : "";
---

<Fragment>
  <div class="d-flex align-items-center gap-3">
    {contentIcon && <IconContainer content={contentIcon} aria-hidden="true" />}
    <p
      class:list={["data-container__value", "align-middle", "m-0", colorClass]}
    >
      {info}
    </p>
  </div>
  <p class:list={["data-container__label", "mb-0", "mt-2", colorClass]}>
    {title}
  </p>
</Fragment>

<style>
  .data-container__value {
    color: var(--color-text-base, #1a1a1a);
    font-weight: 600;
    font-size: 28px;
    line-height: 32px;
  }

  .data-container__label {
    font-weight: 600;
  }
</style>
