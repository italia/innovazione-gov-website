---
import { IconContainer } from "@components/atoms/IconContainer";
import type { CardEditorialWithIconProps } from "./types";

type Props = CardEditorialWithIconProps;

const { title, description, icon } = Astro.props;
---

<div class="it-card it-card-height-full rounded border">
  <div class="it-card-title it-card-title-icon">
    <div class="it-card-title-icon-wrapper mx-0">
      <IconContainer content={icon} />
    </div>
  </div>
  <div class="it-card-body">
    <p class="it-card-subtitle card-with-icon__title mb-2 mt-2">{title}</p>
    <p class="it-card-text">{description}</p>
  </div>
</div>

<style>
  .it-card {
    border: 1px solid var(--color-border-subtle, #c5c7c9);
    border-radius: 4px;
    background: var(--color-blue-97, #f2f7fc);
  }

  .it-card :global(.icon-container) {
    background: #fff;
  }

  .it-card :global(.icon-container .dynamic-icon) {
    width: 32px;
    height: 32px;
  }

  .it-card-body .it-card-subtitle.card-with-icon__title {
    color: var(--color-text-secondary, #2f475e);
    font-weight: 600;
    font-size: 20px;
    line-height: 24px;
  }
</style>
