---
import { DateTime } from "@components/atoms/DateTime";
import { getI18n } from "@i18n/microcopy";
import type { AnnouncementStatusProps } from "@utils/announcementCategory";

type Props = {
  status?: AnnouncementStatusProps;
  deadline?: string;
};

const { status, deadline } = Astro.props;
const { lang } = Astro.locals;
const t = getI18n(lang);
---

{
  status?.label && (
    <span class="announcement-meta__status">
      <span class="visually-hidden">{t["announcement.status.label"]}: </span>
      {status.label}
    </span>
  )
}
{
  deadline && (
    <span class="announcement-meta__deadline">
      {t["announcement.deadline"]}{" "}
      <DateTime className="announcement-meta__date" value={deadline} />
    </span>
  )
}

<style>
  .announcement-meta__status {
    color: var(--color-text-base, #1a1a1a);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.5rem;
  }

  .announcement-meta__deadline {
    color: var(--color-text-secondary, #2f475e);
    font-size: 0.875rem;
    line-height: 1.5rem;
  }
</style>
