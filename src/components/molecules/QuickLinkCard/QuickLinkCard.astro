---
import { ListLink } from "@components/molecules/ListLink";
import { getSectionBgClass } from "@utils/background";
import { slugify } from "@utils/slugify";
import type { QuickLinkCardProps } from "./types";

type Props = QuickLinkCardProps;

const { title, links, background = "primary" } = Astro.props;

const bgClass = getSectionBgClass(background);
const variantTextContainer =
  background === "dark" || background === "primary" ? "dark" : "light";
---

<div
  class=`${bgClass} rounded-2 quick-link-card ${variantTextContainer=== "dark"? "text-white":""}`
>
  {
    title && (
      <h3 class="quick-link-card__title" id={slugify(title)}>
        {title}
      </h3>
    )
  }
  <ListLink items={links} variant={variantTextContainer} />
</div>

<style>
  .quick-link-card {
    margin-block: 2.5rem;
    padding: 1.5rem;
  }

  .quick-link-card :global(.it-list .list-item) {
    margin: 0;
    padding-block: 0;
  }

  .quick-link-card
    :global(.it-list-wrapper .it-list .list-item .it-right-zone) {
    padding-block: 0;
  }

  .quick-link-card :global(.it-list > li + li) {
    margin-top: 1.5rem;
  }
</style>
