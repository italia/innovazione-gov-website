---
import { DateTime } from "@components/atoms/DateTime";
import { Image } from "@components/atoms/Image";
import type { ImageProps } from "@components/atoms/Image/types";

type Props = {
  title: string;
  paragraph?: string | null;
  category?: string | null;
  image?: ImageProps | null;
  linkTo?: string | null;
  isExternal?: boolean;
  dateTime?: string | null;
  fitImage?: "cover" | "contain";
};

const {
  title,
  paragraph,
  category,
  image,
  linkTo,
  isExternal,
  dateTime,
  fitImage = "contain",
} = Astro.props;
---

<div class="wide-link-card">
  {
    image && (
      <div
        class:list={[
          "wide-link-card__media",
          fitImage === "cover" && "wide-link-card__media--cover",
        ]}
      >
        <Image {...image} />
      </div>
    )
  }
  <div class="wide-link-card__body">
    <p class="wide-link-card__title">
      {
        linkTo ? (
          <a
            href={linkTo}
            target={isExternal ? "_blank" : undefined}
            rel={isExternal ? "noopener noreferrer" : undefined}
          >
            {title}
          </a>
        ) : (
          title
        )
      }
    </p>
    {paragraph && <p class="wide-link-card__text">{paragraph}</p>}
    {
      (category || dateTime) && (
        <div class="wide-link-card__meta">
          {category && <span class="wide-link-card__category">{category}</span>}
          {dateTime && (
            <DateTime className="wide-link-card__date" value={dateTime} />
          )}
        </div>
      )
    }
  </div>
</div>

<style>
  .wide-link-card {
    display: flex;
    flex-direction: column;
    border: 1px solid #d4d8dc;
    background: #fff;
    margin-bottom: 1.5rem;
  }
  .wide-link-card__media {
    flex: 0 0 auto;
    background: #f5f6f7;
    aspect-ratio: 16 / 9;
    max-height: 220px;
    overflow: hidden;
  }
  .wide-link-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .wide-link-card__media--cover :global(img) {
    object-fit: cover;
  }
  .wide-link-card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1.5rem;
  }
  .wide-link-card__title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .wide-link-card__title :global(a) {
    color: #06c;
  }
  .wide-link-card__text {
    margin: 0;
    color: #1a1a1a;
    font-size: 1rem;
    line-height: 1.5;
  }
  .wide-link-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
  }
  .wide-link-card :global(.wide-link-card__date) {
    color: #5b6f82;
    font-size: 0.875rem;
  }
  .wide-link-card__category {
    border: 1px solid #d4d8dc;
    border-radius: 999px;
    padding: 0.25rem 0.75rem;
    color: #5b6f82;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .wide-link-card {
      flex-direction: row;
      align-items: stretch;
    }
    .wide-link-card__media {
      flex: 0 0 45%;
      align-self: stretch;
      min-height: 100%;
    }
    .wide-link-card__body {
      flex: 1 1 auto;
      justify-content: center;
    }
  }
</style>
