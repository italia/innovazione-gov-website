---
import AccordionItem from "./AccordionItem.astro";
import type { AccordionProps } from "./types";
type Props = AccordionProps & { fullWidth?: boolean; allOpen?: boolean };
const {
  id,
  items,
  variant = "default",
  fullWidth = true,
  label,
  allOpen = true,
  headingLevel = "h2",
} = Astro.props;

const classiContenitore: Record<typeof variant, string> = {
  default: "",
  "background-active": "accordion-background-active",
  card: "border-0",
};
const className = classiContenitore[variant];
---

{label && <p class="it-label">{label}</p>}
<div class=`accordion ${className}` id={id}>
  {
    items.map((item, index) => (
      <AccordionItem
        idParent={id}
        {...item}
        fullWidth={fullWidth}
        index={index}
        allOpen={allOpen}
        headingLevel={headingLevel}
        variant={variant}
      />
    ))
  }
</div>
