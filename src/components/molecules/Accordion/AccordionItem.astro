---
import { Link } from "@components/atoms/Link";
import type { SiteLocale } from "@graphql/types";
import { getCtaFields } from "@utils/getCtaFields";
import type {
  AccordionHeadingLevel,
  AccordionItemProps,
  VariantAccordionProps,
} from "./types";
type Props = AccordionItemProps & {
  fullWidth?: boolean;
  index: number;
  allOpen?: boolean;
  idParent?: string;
  headingLevel?: AccordionHeadingLevel;
  variant?: VariantAccordionProps;
};
const {
  header,
  body,
  id,
  cta,
  fullWidth = true,
  index,
  allOpen = true,
  idParent,
  headingLevel = "h2",
  variant = "default",
} = Astro.props;

const classiVariante: Record<VariantAccordionProps, Record<string, string>> = {
  default: { item: "bg-transparent", button: "", body: "accordion-body" },
  "background-active": {
    item: "bg-transparent",
    button: "",
    body: "accordion-body",
  },
  card: {
    item: "rounded-2 px-4",
    button: "border-0 border-bottom",
    body: "py-3",
  },
};
const classi = classiVariante[variant];

const isFirst = allOpen || index === 0;
const Heading = headingLevel;

const { lang } = Astro.locals;
const { labelButton, linkTo, openInNewTab } = getCtaFields(
  cta
    ? { ...cta, url: cta.url ?? undefined, linkTo: cta.linkTo ?? undefined }
    : null,
  lang as SiteLocale,
);
---

<div class:list={["accordion-item", classi.item]}>
  <Heading class="accordion-header" id={`heading-${id}`}>
    <button
      class:list={["accordion-button", classi.button, { collapsed: !isFirst }]}
      type="button"
      data-bs-toggle="collapse"
      data-bs-target={`#collapse-${id}`}
      aria-expanded={isFirst ? "true" : "false"}
      aria-controls={`collapse-${id}`}
    >
      {header}
    </button>
  </Heading>
  <div
    id={`collapse-${id}`}
    class:list={["accordion-collapse collapse", { show: isFirst || false }]}
    data-bs-parent={allOpen ? undefined : `#${idParent}`}
    role="region"
    aria-labelledby={`heading-${id}`}
  >
    <div class:list={[classi.body]}>
      {
        fullWidth ? (
          <div set:html={body} />
        ) : (
          <div class="col-12 col-lg-7" set:html={body} />
        )
      }
      {
        labelButton && linkTo && (
          <div class="accordion-item__cta mt-3">
            <Link
              label={labelButton}
              linkTo={openInNewTab ? undefined : linkTo}
              url={openInNewTab ? linkTo : undefined}
              openInNewTab={openInNewTab}
            />
          </div>
        )
      }
    </div>
  </div>
</div>
