---
import { DateTime } from "@components/atoms/DateTime";
import { Image } from "@components/atoms/Image";
import type { TagFragmentType } from "@graphql/fragment/commonFragments";
import { PressReleasesByLocaleQuery } from "@graphql/query/pressReleaseDetail";
import type { SiteLocale } from "@graphql/types";
import { executeQuery } from "@lib/datocms";
import Layout from "@layouts/Layout.astro";
import { type JsonLdPageData } from "@utils/JsonLD/seoJsonLd";

export async function getStaticPaths() {
  const locales: SiteLocale[] = ["it", "en"];
  const paths = [];
  for (const lang of locales) {
    const res = await executeQuery(PressReleasesByLocaleQuery, {
      variables: { locale: lang },
    });
    for (const record of res.allPressReleases) {
      if (!record.slug) continue;
      paths.push({
        params: {
          lang,
          pressRelease: `notizie/comunicati-stampa/${record.slug}`,
        },
        props: { record },
      });
    }
  }
  return paths;
}

const { record } = Astro.props;
const { lang } = Astro.params;

Astro.locals.lang = lang;
Astro.locals.recordId = record.id;

const seoMeta = (record.seoMeta ?? []) as TagFragmentType[];
const categories = record.tags
  .map((tag) => tag.name)
  .filter((name): name is string => !!name);

const jsonLd: JsonLdPageData = {
  pageType: ["content"],
  publishedAt: record.dateShown ?? undefined,
};
---

<Layout
  pageSeo={seoMeta}
  datePublished={record.dateShown ?? undefined}
  jsonLd={jsonLd}
>
  <article class="container py-5 py-lg-80">
    <header class="mb-4">
      <h1>{record.title}</h1>
      {record.subtitle && <p class="lead">{record.subtitle}</p>}
      <div class="d-flex flex-wrap gap-3 align-items-center mt-3">
        {
          record.dateShown && (
            <DateTime className="text-secondary" value={record.dateShown} />
          )
        }
        {
          categories.map((c) => (
            <div class="chip chip-simple">
              <span class="chip-label">{c}</span>
            </div>
          ))
        }
      </div>
    </header>

    {
      record.image && (
        <figure class="mb-4">
          <div class="ratio ratio-16x9">
            <Image {...record.image} />
          </div>
        </figure>
      )
    }

    {record.summary && <p class="fw-semibold fs-5">{record.summary}</p>}
    {record.paragraph && <p>{record.paragraph}</p>}
  </article>
</Layout>

<style>
  figure :global(img) {
    object-fit: cover;
  }
  .chip {
    pointer-events: none;
  }
</style>
