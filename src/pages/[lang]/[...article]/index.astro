---
import SidebarLayoutAdapter from "@components/cms-adapters/datocms/SidebarLayoutAdapter.astro";
import { ArticleHero } from "@components/organisms/ArticleHero";
import { ArticleRelated } from "@components/organisms/ArticleRelated";
import type { ArticleContentFragmentType } from "@graphql/fragment/article";
import { getArticles } from "@lib/dataFetcher";
import { getRelatedArticles } from "@lib/relatedArticles";
import type {
  ImageFragmentType,
  TagFragmentType,
} from "@graphql/fragment/commonFragments";
import type { SidebarFragmentType } from "@graphql/fragment/layout";
import type { SeoFieldFragmentType } from "@graphql/fragment/seoFragments";
import type { SiteLocale } from "@graphql/types";
import Layout from "@layouts/Layout.astro";
import { getLocaleValue } from "@utils/getLocaleValue";
import { type JsonLdPageData } from "@utils/JsonLD/seoJsonLd";
import { linkResolver } from "@utils/linkResolver";
import { removeLang } from "@utils/pathHelper";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
  type PathItem = {
    params: {
      article: string;
      lang: SiteLocale;
    };
    props: {
      seoMeta: TagFragmentType[];
      seo: SeoFieldFragmentType | null;
      content: ArticleContentFragmentType | null;
      id: string;
      sidebar: SidebarFragmentType;
      title: string;
      articleType: string | null;
      dateTime: string | null;
      topics: string[];
      image: ImageFragmentType | null;
      attachments: {
        id: string;
        fileTitle: string | null;
        file: { url: string; filename: string; format: string } | null;
      }[];
      links: {
        id: string;
        title: string | null;
        link: string | null;
        description: string | null;
      }[];
      publishedAt: string;
      updatedAt: string;
    };
  };

  const response = await getCollection("article");
  const sidebarEntry = await getEntry("sidebar", "sidebar");

  const sidebarForArticle = sidebarEntry?.data;

  if (!sidebarForArticle) throw new Error("Sidebar not found");

  const pathsPromises =
    response?.flatMap((item) => {
      const page = item.data;
      return page.locales.map(async (lang) => {
        const seoResCollection = await getEntry(
          "global_seo",
          `${page.id}_${lang}`,
        );
        const seoRes = seoResCollection?.data;

        const fullPath = linkResolver(page.id, lang);

        const slug = removeLang(fullPath, lang);

        return {
          params: {
            article: slug,
            lang: lang,
          },
          props: {
            seoMeta: seoRes?.metaTags || [],
            seo: seoRes?.seo ?? null,
            id: page.id,
            sidebar: { ...sidebarForArticle, id: `sidebar_${page.id}` },
            content: getLocaleValue(page.allContentLocales, lang, null),
            title: getLocaleValue(page.allTitleLocales, lang, ""),
            articleType: page.articleType ?? null,
            dateTime: page.dateShown ?? null,
            topics: (page.tags ?? [])
              .map((tag) => tag.name)
              .filter((name): name is string => !!name),
            image: getLocaleValue(page.allImageLocales, lang, null),
            attachments: page.attachments ?? [],
            links: page.links ?? [],
            publishedAt: page.publishedAt,
            updatedAt: seoRes?.updatedAt || page.updatedAt,
          },
        };
      });
    }) || [];

  const paths = await Promise.all(pathsPromises);

  return paths.filter((path): path is PathItem => !!path.params.lang);
}

const {
  seo,
  seoMeta,
  content,
  id,
  sidebar,
  title,
  articleType,
  dateTime,
  topics,
  image,
  attachments,
  links,
  publishedAt,
  updatedAt,
} = Astro.props;
const { lang } = Astro.params;

Astro.locals.lang = lang;
Astro.locals.recordId = id;

const relatedItems = getRelatedArticles(await getArticles(false), {
  currentId: id,
  tags: topics,
  articleType,
  locale: lang,
});
const jsonLd: JsonLdPageData = {
  pageType: ["content"],
  seo: seo || undefined,
  articleType: "TechArticle",
  publishedAt,
  updatedAt,
};
---

<Layout pageSeo={seoMeta} datePublished={publishedAt} jsonLd={jsonLd}>
  <ArticleHero
    title={title}
    dateTime={dateTime}
    topics={topics}
    image={image}
  />
  {
    content && (
      <SidebarLayoutAdapter
        sidebar={sidebar}
        content={content}
        attachments={attachments}
        links={links}
      />
    )
  }
  <ArticleRelated items={relatedItems} />
</Layout>
