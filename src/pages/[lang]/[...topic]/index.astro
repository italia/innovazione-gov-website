---
import { ButtonLink } from "@components/atoms/Button";
import { Breadcrumb } from "@components/molecules/Breadcrumb";
import { CardTopicEntry } from "@components/molecules/CardTopicEntry";
import { DateTime } from "@components/atoms/DateTime";
import TextAndImageAdapter from "@components/cms-adapters/datocms/TextAndImageAdapter.astro";
import { Hero } from "@components/organisms/Hero";
import { SectionContainer } from "@components/organisms/SectionContainer";
import type { SiteLocale } from "@graphql/types";
import Layout from "@layouts/Layout.astro";
import { createBreadcrumb } from "@utils/createBreadcrumb";
import { getSectionBgClass } from "@utils/background";
import { slugify } from "@utils/slugify";
import { buildTopicPaths } from "@lib/topics";

export async function getStaticPaths() {
  return buildTopicPaths(["it"]);
}

const {
  indiceArgomentiId,
  slug,
  nome,
  descrizione,
  seoMeta: seoDalCms,
  immagineAnteprima,
  sezioni,
  bloccoChiusura,
} = Astro.props;
const { lang } = Astro.params;
const locale = lang as SiteLocale;

Astro.locals.lang = locale;

const breadcrumb = createBreadcrumb(indiceArgomentiId, locale).map((voce) => ({
  ...voce,
  active: false,
}));
breadcrumb.push({ label: nome, linkTo: "#", active: true, id: nome });

const seoCostruito = [
  { tag: "title", content: `${nome} | Argomenti`, attributes: null },
  {
    tag: "meta",
    content: null,
    attributes: {
      name: "description",
      content:
        descrizione ??
        `Notizie, focus e comunicati stampa del Dipartimento sull'argomento ${nome}.`,
    },
  },
];

const seoMeta = seoDalCms?.length ? seoDalCms : seoCostruito;

const dateArticoli = sezioni
  .flatMap((sezione) => sezione.gruppi)
  .flatMap((gruppo) => gruppo.articoli)
  .map((articolo) => articolo.dateShown)
  .filter((data): data is string => Boolean(data));

const ultimoAggiornamento = dateArticoli.length
  ? dateArticoli.reduce((piuRecente, data) =>
      data > piuRecente ? data : piuRecente,
    )
  : undefined;
---

<Layout pageSeo={seoMeta} datePublished={ultimoAggiornamento}>
  <Hero
    title={nome}
    paragraph={descrizione ?? undefined}
    image={immagineAnteprima ?? undefined}
    variant="small"
    backgroundColor="default"
    showBreadcrumb={true}
  >
    <Breadcrumb slot="breadcrumb" items={breadcrumb} />
  </Hero>

  {
    sezioni.map((sezione) => (
      <SectionContainer
        className={getSectionBgClass(sezione.sfondo)}
        sectionTitleId={sezione.titolo}
      >
        <div class="row">
          <div class="col-12">
            <h2 id={slugify(sezione.titolo)}>{sezione.titolo}</h2>
            {sezione.sottotitolo && (
              <p class="topic-section__subtitle">{sezione.sottotitolo}</p>
            )}
          </div>
        </div>
        {sezione.gruppi.map((gruppo) => (
          <div class="row topic-group">
            <div class:list={["col-12", !gruppo.aCard && "col-lg-8"]}>
              {gruppo.titolo && (
                <h3 class="topic-group__title">{gruppo.titolo}</h3>
              )}
              {gruppo.aCard ? (
                <ul class="topic-cards">
                  {gruppo.articoli.map((articolo) => (
                    <li>
                      <CardTopicEntry
                        id={articolo.id}
                        title={articolo.title}
                        paragraph={articolo.paragraph}
                        image={articolo.immagine}
                        linkTo={articolo.path}
                        headingLevel={gruppo.titolo ? "h4" : "h3"}
                      />
                    </li>
                  ))}
                </ul>
              ) : (
                <ul class="topic-articles">
                  {gruppo.articoli.map((articolo) => (
                    <li>
                      <p class="topic-articles__heading">
                        <a href={articolo.path}>{articolo.title}</a>
                        {gruppo.conBadge && articolo.tipo && (
                          <span class="topic-articles__badge">
                            {articolo.tipo}
                          </span>
                        )}
                      </p>
                      {articolo.paragraph && (
                        <p class="topic-articles__text">{articolo.paragraph}</p>
                      )}
                      {articolo.dateShown && (
                        <DateTime
                          className="topic-articles__date"
                          value={articolo.dateShown}
                        />
                      )}
                    </li>
                  ))}
                </ul>
              )}
              {gruppo.percorsoIndice &&
                gruppo.etichettaCta &&
                gruppo.totale > gruppo.articoli.length && (
                  <ButtonLink
                    size="small"
                    label={gruppo.etichettaCta}
                    linkTo={`${gruppo.percorsoIndice}?filter=${slug}`}
                  />
                )}
            </div>
          </div>
        ))}
      </SectionContainer>
    ))
  }

  {bloccoChiusura && <TextAndImageAdapter block={bloccoChiusura} />}
</Layout>

<style>
  .topic-section__subtitle {
    margin-bottom: 2rem;
  }

  .topic-group + .topic-group {
    margin-top: 2.5rem;
  }

  .topic-group__title {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
    line-height: 2rem;
  }

  .topic-cards {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: 1fr;
    gap: 1.5rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 992px) {
    .topic-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .topic-articles {
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }
  .topic-articles li {
    padding-block: 1.25rem;
  }
  .topic-articles a {
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.5rem;
  }
  .topic-articles__heading {
    display: flex;
    flex-wrap: nowrap;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
  }
  .topic-articles__heading a {
    min-width: 0;
  }
  .topic-articles__badge {
    flex: 0 0 auto;
    border-radius: 4px;
    background: #526c84;
    padding: 0.25rem 0.625rem;
    color: var(--color-text-inverse, #fff);
    text-transform: uppercase;
    font-family: "Titillium Web", Geneva, Tahoma, sans-serif;
    font-weight: 600;
    font-size: 14px;
    line-height: 16px;
    white-space: nowrap;
  }
  .topic-articles__text {
    margin: 0.5rem 0 0;
    color: var(--color-text-base, #1a1a1a);
    font-size: 1rem;
    line-height: 1.5rem;
  }
  .topic-articles :global(.topic-articles__date) {
    display: block;
    margin-top: 0.5rem;
    color: #5a6673;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
</style>
