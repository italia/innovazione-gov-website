---
import PageAdapter from "@components/cms-adapters/datocms/PageAdapter.astro";
import { PageSectionsNav } from "@components/organisms/PageSectionsNav";
import { PageWithSidebar } from "@components/layout/PageWithSidebar";
import { getI18n } from "@i18n/microcopy";
import type { TagFragmentType } from "@graphql/fragment/commonFragments";
import type { InsightContentFragmentType } from "@graphql/fragment/insight";
import type { SeoFieldFragmentType } from "@graphql/fragment/seoFragments";
import type { SiteLocale } from "@graphql/types";
import Layout from "@layouts/Layout.astro";
import { getLocaleValue } from "@utils/getLocaleValue";
import { extractFaqItems, type JsonLdPageData } from "@utils/JsonLD/seoJsonLd";
import { extractPageSections, splitPageIntro } from "@utils/pageSections";
import { linkResolver } from "@utils/linkResolver";
import { removeLang } from "@utils/pathHelper";
import { getCollection, getEntry } from "astro:content";
import { Topics } from "@components/molecules/Topics";
import { SectionContainer } from "@components/organisms/SectionContainer";

export async function getStaticPaths() {
  type PathItem = {
    params: {
      insight: string;
      lang: SiteLocale;
    };
    props: {
      seoMeta: TagFragmentType[];
      seo: SeoFieldFragmentType | null;
      content: InsightContentFragmentType[];
      id: string;
      showSectionsNav: boolean;
      sectionsNavLayout: string | null;
      targets: { id: string; label: string }[];
      attachments: {
        id: string;
        fileTitle: string | null;
        file: { url: string; filename: string; format: string } | null;
      }[];
      links: {
        id: string;
        title: string | null;
        link: string | null;
        description: string | null;
      }[];
      publishedAt: string;
      updatedAt: string;
    };
  };

  const response = await getCollection("insight");

  const pathsPromises =
    response?.flatMap((item) => {
      const page = item.data;
      return page.locales.map(async (lang) => {
        const seoResCollection = await getEntry(
          "global_seo",
          `${page.id}_${lang}`,
        );
        const seoRes = seoResCollection?.data;

        const fullPath = linkResolver(page.id, lang);

        const slug = removeLang(fullPath, lang);

        return {
          params: {
            insight: slug,
            lang: lang,
          },
          props: {
            seoMeta: seoRes?.metaTags || [],
            seo: seoRes?.seo ?? null,
            id: page.id,
            showSectionsNav: page.showSectionsNav ?? false,
            sectionsNavLayout: page.sectionsNavLayout ?? null,
            targets: page.targets ?? [],
            attachments: page.attachments ?? [],
            links: page.links ?? [],
            publishedAt: page.publishedAt,
            updatedAt: seoRes?.updatedAt || page.updatedAt,
            content: getLocaleValue(page.allContentLocales, lang, null),
          },
        };
      });
    }) || [];

  const paths = await Promise.all(pathsPromises);

  return paths.filter((path): path is PathItem => !!path.params.lang);
}

const {
  id,
  content,
  seo,
  seoMeta,
  attachments,
  links,
  showSectionsNav,
  sectionsNavLayout,
  targets,
  publishedAt,
  updatedAt,
} = Astro.props;
const { lang } = Astro.params;

Astro.locals.lang = lang;
Astro.locals.recordId = id;

const t = getI18n(lang);
const indiceInSidebar = sectionsNavLayout === "sidebar";
const sections = showSectionsNav
  ? extractPageSections(content, indiceInSidebar ? [2] : [2, 3])
  : [];
const { intro: introBlocks, rest: restBlocks } = splitPageIntro(content);

const jsonLd: JsonLdPageData = {
  pageType: ["content"],
  seo: seo || undefined,
  articleType: "Article",
  publishedAt,
  updatedAt,
  faq: extractFaqItems(content ?? []),
};
---

<Layout pageSeo={seoMeta} datePublished={publishedAt} jsonLd={jsonLd}>
  {introBlocks.length > 0 && <PageAdapter content={introBlocks} />}
  {
    targets.length > 0 && (
      <SectionContainer>
        <Topics
          title={t["article.topics"]}
          topics={targets.map((target) => target.label)}
        />
      </SectionContainer>
    )
  }
  {
    indiceInSidebar && sections.length > 1 ? (
      <PageWithSidebar>
        <PageSectionsNav
          slot="sidebar"
          header={t["toc.title"]}
          items={sections}
          variant="sidebar"
        />
        <PageAdapter
          content={restBlocks}
          attachments={attachments}
          links={links}
        />
      </PageWithSidebar>
    ) : (
      <Fragment>
        <PageSectionsNav header={t["toc.title"]} items={sections} />
        <PageAdapter
          content={restBlocks}
          attachments={attachments}
          links={links}
        />
      </Fragment>
    )
  }
</Layout>
