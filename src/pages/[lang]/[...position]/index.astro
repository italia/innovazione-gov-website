---
import PageAdapter from "@components/cms-adapters/datocms/PageAdapter.astro";
import type { TagFragmentType } from "@graphql/fragment/commonFragments";
import type { JobPositionContentFragmentType } from "@graphql/fragment/jobPosition";
import type { SeoFieldFragmentType } from "@graphql/fragment/seoFragments";
import type { SiteLocale } from "@graphql/types";
import Layout from "@layouts/Layout.astro";
import { getLocaleValue } from "@utils/getLocaleValue";
import { extractFaqItems, type JsonLdPageData } from "@utils/JsonLD/seoJsonLd";
import { linkResolver } from "@utils/linkResolver";
import { removeLang } from "@utils/pathHelper";
import { getCollection, getEntry } from "astro:content";

export async function getStaticPaths() {
  type PathItem = {
    params: {
      position: string;
      lang: SiteLocale;
    };
    props: {
      seoMeta: TagFragmentType[];
      seo: SeoFieldFragmentType | null;
      content: JobPositionContentFragmentType[];
      id: string;
      publishedAt: string;
      updatedAt: string;
    };
  };

  const response = await getCollection("job_position");

  const pathsPromises =
    response?.flatMap((item) => {
      const position = item.data;
      return position.locales.map(async (lang) => {
        const seoResCollection = await getEntry(
          "global_seo",
          `${position.id}_${lang}`,
        );
        const seoRes = seoResCollection?.data;

        const fullPath = linkResolver(position.id, lang);

        const slug = removeLang(fullPath, lang);

        return {
          params: {
            position: slug,
            lang: lang,
          },
          props: {
            seoMeta: seoRes?.metaTags || [],
            seo: seoRes?.seo ?? null,
            id: position.id,
            publishedAt: position.publishedAt,
            updatedAt: seoRes?.updatedAt || position.updatedAt,
            content: getLocaleValue(position.allContentLocales, lang, null),
          },
        };
      });
    }) || [];

  const paths = await Promise.all(pathsPromises);

  // Senza slug nel linkMap (record senza pagina di archivio) il path sarebbe
  // vuoto e collideerebbe con la home della lingua: meglio non generarlo.
  return paths.filter(
    (path): path is PathItem => !!path.params.lang && !!path.params.position,
  );
}

const { id, content, seo, seoMeta, publishedAt, updatedAt } = Astro.props;
const { lang } = Astro.params;

Astro.locals.lang = lang;
Astro.locals.recordId = id;

const jsonLd: JsonLdPageData = {
  pageType: ["content"],
  seo: seo || undefined,
  articleType: "Article",
  publishedAt,
  updatedAt,
  faq: extractFaqItems(content ?? []),
};
---

<Layout pageSeo={seoMeta} datePublished={publishedAt} jsonLd={jsonLd}>
  <PageAdapter content={content} />
</Layout>
